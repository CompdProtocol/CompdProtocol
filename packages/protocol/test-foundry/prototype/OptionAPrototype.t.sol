 function testMaliciousHolderCannotRedirectOrIncreasePayment() external {Env memory e=_env(true,false);_settleProfit(e,108,1000,1200);bytes32 id=keccak256("mal-pay");bytes32 leaf=keccak256("mal-leaf");address recipient=address(0x1234);e.liability.set(leaf,recipient,address(e.token),20,2);e.distributor.setLeaf(id,1,0,leaf,recipient,address(e.token),20,2);e.workflow.setPart(0,0);e.workflow.setPart(2,20);uint256 beforeVault=e.token.balanceOf(address(e.vault));(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.pay,(id,uint32(1),uint16(0),leaf,address(0xBAD),address(0xB0B),uint256(999))));require(!ok&&e.token.balanceOf(address(e.vault))==beforeVault&&e.token.balanceOf(address(0xBAD))==0);}
 function testMaliciousSettlementCannotFabricateProfit() external {Env memory e=_env(false,true);vm.prank(address(e.exec));e.vault.allocate(109,1000);e.token.mint(address(e.exec),1200);e.exec.setRun(109,1000,1200,2,true);uint64 n=uint64(e.vault.consumed(1));bytes32 evidence=keccak256(abi.encode(uint256(109),address(e.token),uint256(1000),uint256(1200),uint8(2),true));uint64 st=uint64(block.timestamp/28800*28800);bytes32 wid=keccak256(abi.encode(block.timestamp/28800));bytes32 c=keccak256(abi.encode(block.chainid,address(e.vault),address(e.settlement),uint8(1),uint256(109),address(e.token),uint256(1000),uint256(1200),n,evidence,wid,st,st+28800));vm.prank(address(e.exec));(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.settle,(uint256(109),uint256(1200),n,c)));require(!ok&&e.vault.holderRewardReserve()==0&&e.vault.buybackReserve()==0);}
 function testChangedPaymentAmountRejected() external {Env memory e=_env();e.liability.set(keccak256("leaf"),address(0x1234),address(e.token),3,2);(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.pay,(bytes32(uint256(1)),uint32(1),uint16(0),keccak256("leaf"),address(0x1234),address(e.token),uint256(4))));require(!ok);}
 function testChangedPaymentAssetRejected() external {Env memory e=_env();e.liability.set(keccak256("leaf"),address(0x1234),address(e.token),3,2);(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.pay,(bytes32(uint256(1)),uint32(1),uint16(0),keccak256("leaf"),address(0x1234),address(0x9999),uint256(3))));require(!ok);}
 function testEmergencyEntrySurvivesEveryExternalComponentReverting() external {Env memory e=_env();e.workflow.setFail(true);e.liability.setFail(true);e.registry.setFail(true);vm.prank(address(0xCAFE));e.vault.emergencyEnter();require(e.vault.lifecycle()==4&&e.vault.emergencySnapshot()!=bytes32(0));require(e.vault.emergencyQuoteBalance()==10000&&e.vault.preEmergencyDeficit()==0&&e.vault.emergencyProcessingStatus()==1&&e.vault.emergencyNonce()==1);}
 function testRepeatedEmergencyEntryRejected() external {Env memory e=_env();vm.prank(address(0xCAFE));e.vault.emergencyEnter();vm.prank(address(0xCAFE));(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.emergencyEnter,()));require(!ok);}
 function testRecoveryFixedRecipientNoArgument() external {Env memory e=_env();_settleProfit(e,12,1000,1100);e.workflow.makeRecoveryEligible(10);e.vault.recover(keccak256("eligible"));require(e.token.balanceOf(address(0xFa8706AA97B07cb29096381f9101784bA0d1332b))==10);}
 function testMaliciousEmergencyControllerCannotSubstituteRegisteredScope() external {Env memory e=_env(false,false,true);vm.prank(address(0xCAFE));e.vault.emergencyEnter();uint256 beforeBal=e.token.balanceOf(address(e.vault));(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.emergencyTransfer,(uint8(1),address(e.exec),address(e.token),uint256(10),bytes32(uint256(1)))));require(!ok&&e.token.balanceOf(address(e.vault))==beforeBal);}
 function testEmergencyWrongAssetRejected() external {Env memory e=_env();vm.prank(address(0xCAFE));e.vault.emergencyEnter();(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.emergencyTransfer,(uint8(1),address(e.exec),address(0x1234),uint256(1),bytes32(0))));require(!ok);}
 function testEmergencyRegistryFailureRollsBackTransfer() external {Env memory e=_env();vm.prank(address(0xCAFE));e.vault.emergencyEnter();e.registry.setFail(true);bytes32 c=keccak256(abi.encode(block.chainid,address(e.vault),address(e.emergency),uint8(4),address(e.exec),uint8(1),address(e.token),uint32(1)));uint256 beforeBal=e.token.balanceOf(address(e.vault));(bool ok,)=address(e.vault).call(abi.encodeCall(e.vault.emergencyTransfer,(uint8(1),address(e.exec),address(e.token),uint256(10),c)));require(!ok&&e.token.balanceOf(address(e.vault))==beforeBal);}
