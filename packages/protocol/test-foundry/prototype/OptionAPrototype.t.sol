contract MockTokenP {
 mapping(address=>uint256) public balanceOf;
 function mint(address a,uint256 n) external {balanceOf[a]+=n;}
 function transfer(address to,uint256 n) external returns(bool){require(balanceOf[msg.sender]>=n);balanceOf[msg.sender]-=n;balanceOf[to]+=n;return true;}
 function transferFrom(address from,address to,uint256 n) external returns(bool){require(balanceOf[from]>=n);balanceOf[from]-=n;balanceOf[to]+=n;return true;}
}
contract MockWorkflowP is IProtoWorkflow {
 address public immutable vault; bytes32 public constant COMPONENT_TYPE_ID=keccak256("COMPD_HOLDER_WORKFLOW_V2"); uint32 public constant COMPONENT_VERSION=2;
 uint256 public pool; uint256[5] public p; bool public fail; bytes32 public distRoot; uint32 public distVersion; uint256 public distAmount; uint64 public ready; uint8 public status;
 constructor(address v){vault=v;} function windowPool(bytes32) external view returns(uint256){if(fail)revert();return pool;}
 function accrueHolderPool(uint256,bytes32,uint64,uint64,uint256 a,uint256 expected) external {require(msg.sender==vault&&!fail&&pool+a==expected);pool=expected;p[0]+=a;}
 function distribution(bytes32) external view returns(bytes32,uint32,uint256,uint64,uint8){if(fail)revert();return(distRoot,distVersion,distAmount,ready,status);}
 function finalize(bytes32,uint32,uint256 a) external {require(msg.sender==vault&&!fail&&status==1&&p[1]>=a);p[1]-=a;p[2]+=a;status=2;}
 function paymentProcessed(bytes32,uint256 a) external {require(msg.sender==vault&&!fail&&p[2]>=a);p[2]-=a;}
 function correctDistributionCandidate(bytes32,uint32 nv,bytes32 nr,uint64 ex,uint256,uint16) external {require(msg.sender==vault&&!fail&&status==1&&nv==distVersion+1);distVersion=nv;distRoot=nr;ready=ex;}
 function partitions() external view returns(uint256,uint256,uint256,uint256,uint256){if(fail)revert();return(p[0],p[1],p[2],p[3],p[4]);}
 function eligible(bytes32) external view returns(uint256,bool){if(fail)revert();return(p[4],p[4]>0);}
 function recovered(bytes32) external {require(msg.sender==vault&&!fail&&p[4]>0);p[4]=0;}
 function makeRecoveryEligible(uint256 a) external {require(p[0]>=a);p[0]-=a;p[4]+=a;}
 function setDist(bytes32 r,uint32 v,uint256 a,uint64 t,uint8 s) external {require(p[0]>=a);p[0]-=a;p[1]+=a;distRoot=r;distVersion=v;distAmount=a;ready=t;status=s;}
 function setFail(bool b) external {fail=b;} function setPart(uint8 i,uint256 a) external {p[i]=a;}
}
contract MockLiabilityP is IProtoLiability {
 address public immutable vault; bytes32 public constant COMPONENT_TYPE_ID=keccak256("COMPD_HOLDER_LIABILITY_V2"); uint32 public constant COMPONENT_VERSION=2;
 bytes32 public leaf; address public to; address public asset; uint256 public amount; uint8 public status; bool public fail;
 constructor(address v){vault=v;} function summary(bytes32,uint32,uint16) external view returns(bytes32,address,address,uint256,uint8){if(fail)revert();return(leaf,to,asset,amount,status);}
 function distributionSummary(bytes32,uint32) external view returns(uint256,uint16,bool,bool){if(fail)revert();return(amount,amount==0?0:1,status==2||status==5,status==6);}
 function finalize(bytes32,uint32,uint256) external {require(msg.sender==vault&&!fail&&status==1);status=2;}
 function supersede(bytes32,uint32,uint16 i) external returns(bool){require(msg.sender==vault&&!fail);if(i==0&&status==1)status=6;return true;}
 function supersedeVersion(bytes32,uint32) external {require(msg.sender==vault&&!fail&&status==1);for(uint16 i;i<30;i++){if(i==0)status=6;}}
 function paid(bytes32,uint32,uint16) external {require(msg.sender==vault&&!fail&&status==2);status=5;}
 function expired(bytes32) external view returns(uint256,bool){return(0,false);} function recovered(bytes32) external {revert();}
 function set(bytes32 h,address t,address a,uint256 n,uint8 s) external {leaf=h;to=t;asset=a;amount=n;status=s;} function setFail(bool b) external {fail=b;}
}
contract MockDistributorP is IProtoDistributor {address public immutable vault;bytes32 public constant COMPONENT_TYPE_ID=keccak256("COMPD_HOLDER_REWARDS_DISTRIBUTOR_V2");uint32 public constant COMPONENT_VERSION=2;bytes32 public root;uint32 public ver;uint256 public amount;uint16 public count;uint64 public ready;bytes32 public commitment;mapping(bytes32=>mapping(uint32=>mapping(uint16=>bytes32))) public leaves;mapping(bytes32=>mapping(uint32=>mapping(uint16=>address))) public recipients;mapping(bytes32=>mapping(uint32=>mapping(uint16=>address))) public assets;mapping(bytes32=>mapping(uint32=>mapping(uint16=>uint256))) public values;mapping(bytes32=>mapping(uint32=>mapping(uint16=>uint8))) public states;constructor(address v){vault=v;}function candidate(bytes32) external view returns(bytes32,uint32,uint256,uint16,uint64,bytes32){return(root,ver,amount,count,ready,commitment);}function leaf(bytes32 id,uint32 v,uint16 i) external view returns(bytes32,address,address,uint256,uint8){return(leaves[id][v][i],recipients[id][v][i],assets[id][v][i],values[id][v][i],states[id][v][i]);}function set(bytes32 r,uint32 v,uint256 a,uint16 c,uint64 t) external{root=r;ver=v;amount=a;count=c;ready=t;commitment=keccak256(abi.encode(r,v,a,c,t));}function correctCandidate(bytes32,uint32 nv,bytes32 nr,uint64 ex) external {require(msg.sender==vault&&nv==ver+1);ver=nv;root=nr;ready=ex;commitment=keccak256(abi.encode(nr,nv,amount,count,ex));}function setLeaf(bytes32 id,uint32 v,uint16 i,bytes32 h,address to,address asset,uint256 a,uint8 s) external{leaves[id][v][i]=h;recipients[id][v][i]=to;assets[id][v][i]=asset;values[id][v][i]=a;states[id][v][i]=s;}}
contract MockRegistryP is IProtoRegistry {address public immutable vault;bytes32 public constant COMPONENT_TYPE_ID=keccak256("COMPD_EMERGENCY_REGISTRY_V2");uint32 public constant COMPONENT_VERSION=2;mapping(bytes32=>uint32) public override attempts; bool public fail;constructor(address v){vault=v;}function attempt(bytes32 id,uint32 n,address,uint256,uint256) external {if(fail)revert();require(attempts[id]+1==n);attempts[id]=n;}function setFail(bool b) external{fail=b;}}
