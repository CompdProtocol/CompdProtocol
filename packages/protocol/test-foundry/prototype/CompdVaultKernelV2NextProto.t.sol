pragma solidity ^0.8.37;
import {CompdVaultKernelV2NextProto,CompdSettlementModuleV2NextProto,CompdHolderModuleV2NextProto,CompdBuybackModuleV2NextProto,CompdRecoveryModuleV2NextProto,CompdEmergencyModuleV2NextProto} from "../../contracts/prototype/CompdVaultKernelV2NextProto.sol";

interface VmNext {function prank(address) external;function expectRevert() external;function warp(uint256) external;function deal(address,uint256) external;}
contract NextHolderAuthority {mapping(bytes32=>bool) public approved;function approve(address to,address asset,uint256 amount,bytes32 id,bytes32 leaf)external{approved[keccak256(abi.encode(to,asset,amount,id,leaf))]=true;}function isCanonical(address to,address asset,uint256 amount,bytes32 id,bytes32 leaf)external view returns(bool){return approved[keccak256(abi.encode(to,asset,amount,id,leaf))];}}
contract NextSettlementAuthority {mapping(bytes32=>bool) public approved;function approve(uint256 run,uint256 principal,uint256 returned,bytes32 evidence)external{approved[keccak256(abi.encode(run,principal,returned,evidence))]=true;}function isCanonical(uint256 run,uint256 principal,uint256 returned,bytes32 evidence)external view returns(bool){return approved[keccak256(abi.encode(run,principal,returned,evidence))];}}
contract CompdVaultKernelV2NextProtoTest {
    VmNext constant vm=VmNext(address(uint160(uint256(keccak256("hevm cheat code")))));
    address constant ADMIN=address(0xA11CE);address constant GUARD=address(0xB0B);address constant EMERGENCY_AUTH=address(0xE911);address constant RECOVERY=address(0xCAFE);address constant EMERGENCY=address(0xD00D);address constant USER=address(0x1234);
    NextHolderAuthority ha;NextSettlementAuthority sa;CompdVaultKernelV2NextProto k;CompdSettlementModuleV2NextProto s;CompdHolderModuleV2NextProto h;CompdBuybackModuleV2NextProto b;CompdRecoveryModuleV2NextProto r;CompdEmergencyModuleV2NextProto e;
    function setUp()public{ha=new NextHolderAuthority();sa=new NextSettlementAuthority();k=new CompdVaultKernelV2NextProto(address(0),ADMIN,GUARD,RECOVERY,EMERGENCY_AUTH,EMERGENCY,address(ha),address(0xBEEF),address(0xCA11),address(sa));s=new CompdSettlementModuleV2NextProto(address(k));h=new CompdHolderModuleV2NextProto(address(k));b=new CompdBuybackModuleV2NextProto(address(k));r=new CompdRecoveryModuleV2NextProto(address(k));e=new CompdEmergencyModuleV2NextProto(address(k));address[5] memory m=[address(s),address(h),address(b),address(r),address(e)];vm.prank(ADMIN);k.bind(m);vm.prank(ADMIN);k.activate();}
    function _fund(uint256 n)internal{vm.deal(address(k),address(k).balance+n);}
    function _seed(uint256 n)internal{vm.deal(ADMIN,ADMIN.balance+n);vm.prank(ADMIN);k.seed{value:n}();}
    function _settle(uint256 run,uint256 principal,uint256 returned)internal{bytes32 evidence=bytes32(run);sa.approve(run,principal,returned,evidence);vm.prank(address(s));k.settle(run,principal,returned,evidence);}
    function testFuzz_BucketConservation(uint96 raw)public{uint256 n=uint256(raw)%1e24+1;_seed(n);assertEq(k.strategyCapital(),n);assertEq(k.accountedQuote(),n);}
    function testFuzz_ProfitSplitConservation(uint96 raw)public{uint256 p=uint256(raw)%1e20+100;_seed(p);vm.prank(address(s));k.allocate(1,p);_fund(p+p/7);_settle(1,p,p+p/7);uint256 profit=p/7;assertEq(k.strategyCapital()+k.buybackReserve()+k.protocolReserve()+k.holderRewardReserve(),k.accountedQuote());assertEq(k.buybackReserve(),profit*15/100);assertEq(k.holderRewardReserve(),profit*10/100);assertEq(k.protocolReserve(),profit-(profit*65/100)-(profit*15/100)-(profit*10/100));}
    function testFuzz_FlapSplitConservation(uint96 raw)public{uint256 n=uint256(raw)%1e20+1;_seed(1);_fund(n);vm.prank(address(s));k.flapRevenue(n,bytes32(uint256(2)));assertEq(k.strategyCapital(),1+n*35/100);assertEq(k.buybackReserve(),n*15/100);assertEq(k.protocolReserve(),n-n*35/100-n*15/100);assertEq(k.accountedQuote(),k.strategyCapital()+k.buybackReserve()+k.protocolReserve()+k.holderRewardReserve());}
    function _createHolderReserve(uint256 n,uint256 run)internal{_seed(10*n);vm.prank(address(s));k.allocate(run,10*n);_fund(20*n);_settle(run,10*n,20*n);}
    function testFuzz_HolderPayBounded(uint96 raw)public{uint256 n=uint256(raw)%1e20+1;_createHolderReserve(n,3);ha.approve(USER,address(0),n,bytes32(uint256(4)),bytes32(uint256(5)));h.pay(USER,n,bytes32(uint256(4)),bytes32(uint256(5)));assertEq(USER.balance,n);assertEq(k.holderRewardReserve(),0);}
    function testFuzz_RecoveryDestinationImmutable(uint96 raw)public{uint256 n=uint256(raw)%1e20+1;_seed(1);_fund(n);vm.prank(address(s));k.flapRevenue(n,bytes32(uint256(6)));uint256 eligible=n-n*35/100-n*15/100;vm.prank(GUARD);k.initiateShutdown();vm.warp(block.timestamp+72 hours);vm.prank(GUARD);k.terminate();vm.prank(address(r));k.recover(eligible,bytes32(uint256(7)));assertEq(RECOVERY.balance,eligible);assertEq(USER.balance,0);}
    function testFuzz_EmergencyDestinationImmutable(uint96 raw)public{uint256 n=uint256(raw)%1e20+1;_seed(1);_fund(n);vm.prank(address(s));k.flapRevenue(n,bytes32(uint256(8)));vm.prank(EMERGENCY_AUTH);k.emergencyEnter();vm.prank(address(e));k.emergencyRecoverQuote(n-n*35/100-n*15/100,bytes32(uint256(9)));assertEq(EMERGENCY.balance,n-n*35/100-n*15/100);assertEq(USER.balance,0);}
    function testFuzz_CapabilityReplayRejected(uint96 raw)public{uint256 n=uint256(raw)%1e20+1;_seed(1);_fund(n);vm.prank(address(s));k.flapRevenue(n,bytes32(uint256(10)));vm.prank(address(s));vm.expectRevert();k.flapRevenue(n,bytes32(uint256(10)));}
    function testFuzz_ModuleDomainIsolation(uint96 raw)public{uint256 n=uint256(raw)%1e20+1;_seed(n);vm.prank(address(h));vm.expectRevert();k.allocate(77,n);vm.prank(address(b));vm.expectRevert();k.recover(n,bytes32(uint256(11)));vm.prank(USER);vm.expectRevert();k.buyback(n,bytes32(uint256(12)),0,0);}
    function testHolderCannotSubstituteRecipient()public{_createHolderReserve(5,20);ha.approve(USER,address(0),5,bytes32(uint256(14)),bytes32(uint256(15)));vm.prank(address(h));vm.expectRevert();k.payHolder(address(0xBAD),5,bytes32(uint256(14)),bytes32(uint256(15)));}
    function testBuybackKernelHardLimitsAndFixedDestination()public{_seed(1 ether);_fund(2 ether);vm.prank(address(s));k.flapRevenue(2 ether,bytes32(uint256(16)));b.release(0.06 ether,bytes32(uint256(17)),300,300);assertEq(address(0xBEEF).balance,0.06 ether);}
    function testBuybackCannotExceedPerExecutionShare()public{_seed(1 ether);_fund(2 ether);vm.prank(address(s));k.flapRevenue(2 ether,bytes32(uint256(18)));vm.prank(address(b));vm.expectRevert();k.buyback(0.07 ether,bytes32(uint256(19)),300,300);}
    function testBuybackCooldownAndRollingCapAreKernelEnforced()public{_seed(1 ether);_fund(4 ether);vm.prank(address(s));k.flapRevenue(4 ether,bytes32(uint256(21)));b.release(0.09 ether,bytes32(uint256(22)),100,100);vm.expectRevert();b.release(0.09 ether,bytes32(uint256(23)),100,100);vm.warp(block.timestamp+6 hours);b.release(0.09 ether,bytes32(uint256(23)),100,100);vm.warp(block.timestamp+6 hours);vm.expectRevert();b.release(0.07 ether,bytes32(uint256(24)),100,100);}
    function testSettlementRequiresCanonicalExecutorEvidence()public{_seed(20);vm.prank(address(s));k.allocate(30,20);_fund(20);vm.prank(address(s));vm.expectRevert();k.settle(30,20,20,bytes32(uint256(30)));}
    function testSettlementEvidenceCannotReassignPrincipalAcrossRuns()public{_seed(100);vm.prank(address(s));k.allocate(31,30);vm.prank(address(s));k.allocate(32,70);_fund(100);bytes32 evidence=bytes32(uint256(31));sa.approve(31,100,100,evidence);vm.prank(address(s));vm.expectRevert();k.settle(31,100,100,evidence);}
    function testNegativeSettlementDoesNotFabricate()public{_seed(100);vm.prank(address(s));k.allocate(1,60);_fund(40);_settle(1,60,40);assertEq(k.strategyCapital(),80);assertEq(k.accountedQuote(),80);assertEq(k.activePrincipal(),0);}
    function testEmergencyRequiresBacking()public{_seed(10);_fund(1);vm.prank(EMERGENCY_AUTH);k.emergencyEnter();assertEq(uint256(k.lifecycle()),4);}
    function assertEq(uint256 a,uint256 expected)private pure{require(a==expected,"neq");}
}
