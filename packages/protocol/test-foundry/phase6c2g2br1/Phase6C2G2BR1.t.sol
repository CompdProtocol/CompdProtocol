contract TExecutor is IC2G2BStrategyExecutor {
    mapping(uint256=>uint256) public principal; uint256 public returned; uint256 public sendAmount; T.RunStatus public nextStatus=T.RunStatus.EXIT_REQUESTED; address public kernel;
    function isApprovedStrategy(address) external pure returns(bool){return true;}
    function openRun(uint256 id,address,uint256 amount,uint256,bytes32 allocationId) external payable returns(bytes32){require(msg.value==amount);kernel=msg.sender;principal[id]=amount;return allocationId;}
    function setReturned(uint256 r) external {returned=r;sendAmount=r;} function setMismatch(uint256 r,uint256 s) external {returned=r;sendAmount=s;}
    function requestExit(uint256,bytes32) external view returns(T.RunStatus){return nextStatus;}
    function closeToKernel(uint256 id,bytes32 closeId) external returns(uint256,uint256,bytes32){require(msg.sender==kernel);uint256 p=principal[id];uint256 r=returned;uint256 s=sendAmount;require(address(this).balance>=s);(bool ok,)=payable(msg.sender).call{value:s}("");require(ok);principal[id]=0;return(p,r,closeId);}
    receive() external payable {}
}
contract TBuybackExec {}
contract TQuote {function policyHash() external pure returns(bytes32){return 0;}function quote(bytes32) external pure returns(bytes32,uint256,uint64,uint256){return(0,0,0,0);}}
contract TRecovery is IC2G2BRecoveryEvidence {
    mapping(bytes32=>uint256) public amount;mapping(bytes32=>uint8) public kind;mapping(bytes32=>bool) public used;
    function set(bytes32 id,uint8 k,uint256 a) external {kind[id]=k;amount[id]=a;}
    function protocolReserveRecovery(bytes32 id) external view returns(bool,uint256){return(kind[id]==0&&!used[id],amount[id]);}
    function noRecipientRecovery(bytes32 id) external view returns(bool,uint256){return(kind[id]==1&&!used[id],amount[id]);}
    function expiredHolderRecovery(bytes32 id) external view returns(bool,uint256){return(kind[id]==2&&!used[id],amount[id]);}
    function consumeProtocolReserve(bytes32 id) external {require(!used[id]&&kind[id]==0);used[id]=true;}
    function consumeNoRecipient(bytes32 id) external {require(!used[id]&&kind[id]==1);used[id]=true;}
    function consumeExpiredHolder(bytes32 id) external {require(!used[id]&&kind[id]==2);used[id]=true;}
    function recoveryReconciliationComplete() external pure returns(bool){return true;}
}
contract THolderDistributor is IC2G2BHolderDistributor {
    mapping(bytes32=>T.HolderPayment) private _p;mapping(bytes32=>bytes32) private _digest;mapping(bytes32=>bool) private _used;
    function set(T.HolderPayment calldata p,bytes32 d) external {_p[p.leafId]=p;_digest[p.leafId]=d;}
    function paymentData(bytes32 id) external view returns(T.HolderPayment memory,bool){return(_p[id],_digest[id]!=0&&!_used[id]);}
    function paymentDigest(bytes32 id) external view returns(bytes32){return _digest[id];}
    function canonicalPayment(bytes32 id) external view returns(bytes32,address,address,uint256,uint8,bool){T.HolderPayment storage p=_p[id];return(_digest[id],p.recipient,p.asset,p.amount,p.distributionStatus,_digest[id]!=0&&!_used[id]);}
    function consumePayment(bytes32 id,bytes32 d) external {require(_digest[id]==d&&!_used[id]);_used[id]=true;}
    function terminalReconciliation() external pure returns(bytes32,uint256){return(bytes32(uint256(1)),0);}
}
contract THolderLiability is IC2G2BHolderLiability {
    mapping(bytes32=>T.HolderPayment) private _p;mapping(bytes32=>bytes32) private _digest;mapping(bytes32=>bool) private _used;
    function set(T.HolderPayment calldata p,bytes32 d) external {_p[p.leafId]=p;_digest[p.leafId]=d;}
    function paymentDigest(bytes32 id) external view returns(bytes32){return _digest[id];}
    function canonicalPayment(bytes32 id) external view returns(bytes32,address,address,uint256,uint8,bool){T.HolderPayment storage p=_p[id];return(_digest[id],p.recipient,p.asset,p.amount,p.liabilityStatus,_digest[id]!=0&&!_used[id]);}
    function consumePayment(bytes32 id,bytes32 d) external {require(_digest[id]==d&&!_used[id]);_used[id]=true;}
    function terminalReconciliation() external pure returns(bytes32,uint256){return(bytes32(uint256(1)),0);}
}
contract TReceiver {bool public reject=true;function allow() external {reject=false;}receive() external payable {require(!reject);}}

contract Phase6C2G2BR1Test is Test {
    address constant ADMIN=0x7Ea65A566e08862ebaFabF564A7A069E10DFd5e9;address constant GUARDIAN=0x34c5F07750aC19ff28d73FE039456Aa11e2f8eC1;address constant AUTOMATION=0xB878884A07Fc84e6A1336e15CA8C6580cD7164c3;address constant RECOVERY_TREASURY=0xFa8706AA97B07cb29096381f9101784bA0d1332b;
    TExecutor executor;TBuybackExec buyExec;THolderDistributor dist;THolderLiability liability;TRecovery evidence;CompdVaultKernelV2 kernel;CompdSettlementModuleV2 settlement;CompdHolderModuleV2 holder;CompdBuybackModuleV2 buyback;CompdRecoveryModuleV2 recovery;CompdEmergencyScopeRegistryV2 registry;CompdEmergencyModuleV2 emergency;CompdProtocolLensV2 lens;
    function setUp() public {executor=new TExecutor();buyExec=new TBuybackExec();dist=new THolderDistributor();liability=new THolderLiability();evidence=new TRecovery();address emergencyAuthority=address(0xE001);address emergencyWallet=address(0xE002);kernel=new CompdVaultKernelV2(emergencyAuthority,emergencyWallet,address(executor),address(buyExec),address(dist),address(liability),address(evidence));registry=new CompdEmergencyScopeRegistryV2(address(kernel));emergency=new CompdEmergencyModuleV2(address(kernel),address(registry));settlement=new CompdSettlementModuleV2(address(kernel),address(executor));holder=new CompdHolderModuleV2(address(kernel),address(dist),address(liability));buyback=new CompdBuybackModuleV2(address(kernel),address(0));recovery=new CompdRecoveryModuleV2(address(kernel),address(evidence));lens=new CompdProtocolLensV2(address(kernel),address(settlement),address(registry));vm.prank(ADMIN);registry.bindEmergencyModule(address(emergency));address[6] memory mods=[address(settlement),address(holder),address(buyback),address(recovery),address(emergency),address(registry)];vm.prank(ADMIN);kernel.bindModules(mods);vm.deal(ADMIN,20 ether);vm.prank(ADMIN);kernel.seedStrategyCapital{value:10 ether}();vm.prank(ADMIN);kernel.activate();}
    function _openAndClose(uint256 p,uint256 r,uint256 id) internal {bytes32 alloc=keccak256(abi.encode("a",id));vm.prank(AUTOMATION);settlement.startRun(id,address(0xA11CE),p,alloc);executor.setReturned(r);vm.deal(address(executor),r);vm.prank(AUTOMATION);settlement.requestExit(id,keccak256(abi.encode("exit",id)));vm.prank(AUTOMATION);settlement.closeRun(id,keccak256(abi.encode("close",id)));}
    function _payment(address recipient,uint256 amount) internal returns(T.HolderPayment memory p,bytes32 digest){p=T.HolderPayment(bytes32(uint256(1)),bytes32(uint256(2)),1,0,bytes32(uint256(3)),bytes32(uint256(4)),bytes32(uint256(5)),recipient,address(0),amount,1,1,uint64(block.timestamp),uint64(block.timestamp+1 days),0,bytes32(uint256(6)));digest=keccak256(abi.encode(keccak256("COMPD_HOLDER_PAYMENT_V2"),block.chainid,address(kernel),p.windowId,p.distributionId,p.version,p.index,p.root,p.lineage,p.leafId,p.recipient,p.asset,p.amount,p.distributionStatus,p.liabilityStatus,p.finalizedAt,p.expiresAt,p.recoveryStatus,p.useId));dist.set(p,digest);liability.set(p,digest);}
    function testProfitSplitPhysicalSettlementAndRiskRun() public { _openAndClose(1 ether,1.1 ether,1);assertEq(kernel.strategyCapital(),10.065 ether);assertEq(kernel.buybackReserve(),0.015 ether);assertEq(kernel.holderRewardReserve(),0.01 ether);assertEq(kernel.protocolReserve(),0.01 ether);assertEq(kernel.accountedQuote(),10.1 ether);assertEq(kernel.activePrincipal(),0);(,,,,uint256 hr,uint256 aq,uint256 ap)=lens.accounting();assertEq(hr,0.01 ether);assertEq(aq,10.1 ether);assertEq(ap,0); }
    function testLossReducesStrategyCapitalOnly() public {_openAndClose(1 ether,0.4 ether,1);assertEq(kernel.strategyCapital(),9.4 ether);assertEq(kernel.buybackReserve(),0);assertEq(kernel.holderRewardReserve(),0);assertEq(kernel.protocolReserve(),0);assertEq(kernel.cumulativeRealizedLoss(),0.6 ether);assertTrue(settlement.riskLatched());}
    function testHolderFailureDoesNotDebitAndSameIdentityCanRetry() public {_openAndClose(1 ether,1.1 ether,1);TReceiver r=new TReceiver();(T.HolderPayment memory p,)=_payment(address(r),0.005 ether);uint256 hr=kernel.holderRewardReserve();uint256 aq=kernel.accountedQuote();vm.prank(AUTOMATION);assertFalse(holder.pay(p.leafId));assertEq(kernel.holderRewardReserve(),hr);assertEq(kernel.accountedQuote(),aq);r.allow();vm.prank(AUTOMATION);assertTrue(holder.retry(p.useId));assertTrue(kernel.holderPaid(p.useId));assertEq(kernel.holderRewardReserve(),hr-p.amount);}
    function testHCMismatchRejectedBeforeTransfer() public {_openAndClose(1 ether,1.1 ether,1);(T.HolderPayment memory p,bytes32 d)=_payment(address(this),0.005 ether);T.HolderPayment memory bad=p;bad.amount+=1;dist.set(bad,d);vm.expectRevert();vm.prank(AUTOMATION);holder.pay(p.leafId);assertFalse(kernel.holderPaid(p.useId));}
    function testEmergencyEntryWorksWithoutRegistryOrModules() public {TExecutor e=new TExecutor();TBuybackExec b=new TBuybackExec();THolderDistributor d=new THolderDistributor();THolderLiability l=new THolderLiability();TRecovery r=new TRecovery();address authority=address(0xE101);CompdVaultKernelV2 k=new CompdVaultKernelV2(authority,address(0xE102),address(e),address(b),address(d),address(l),address(r));vm.deal(ADMIN,1 ether);vm.prank(ADMIN);k.seedStrategyCapital{value:1 ether}();vm.prank(authority);k.emergencyEnter();assertEq(uint8(k.lifecycle()),uint8(T.Lifecycle.EMERGENCY_RECOVERY));assertNotEq(k.emergencySnapshotId(),bytes32(0));}
    function testRegistryAppendOnlyAttemptsAndLateDiscovery() public {vm.prank(address(0xE001));kernel.emergencyEnter();bytes32[] memory ids=new bytes32[](1);ids[0]=bytes32(uint256(11));uint8[] memory kinds=new uint8[](1);kinds[0]=uint8(T.ScopeKind.BNB);vm.prank(address(0xE001));emergency.initialize(ids,kinds);bytes32 aid=bytes32(uint256(12));vm.prank(address(0xE001));emergency.beginWorkflowAttempt(ids[0],aid,1);vm.prank(address(0xE001));emergency.finishWorkflowAttempt(ids[0],aid,1,T.AttemptStatus.BLOCKED,bytes32(uint256(13)));bytes32 late=bytes32(uint256(14));vm.prank(address(0xE001));emergency.discover(late,uint8(T.ScopeKind.MODULE),bytes32(uint256(15)));(uint256 count,uint256 open,uint256 pending,uint256 blocked,bool ready)=registry.summary(kernel.emergencySnapshotId());assertEq(count,2);assertEq(open,1);assertEq(pending,0);assertEq(blocked,1);assertFalse(ready);assertEq(uint8(kernel.emergencyStatus()),uint8(T.ProcessingStatus.IN_PROGRESS));}
    function testShutdownExtendOnlyThenTypedRecovery() public {_openAndClose(1 ether,1.1 ether,1);bytes32 id=keccak256("PR source");evidence.set(id,0,0.01 ether);vm.prank(GUARDIAN);kernel.initiateShutdown(72 hours);uint64 beforeAt=kernel.shutdownAt();vm.prank(GUARDIAN);kernel.extendShutdown(beforeAt+1 days);assertGt(kernel.shutdownAt(),beforeAt);vm.warp(kernel.shutdownAt());vm.prank(GUARDIAN);kernel.terminate();assertEq(uint8(kernel.lifecycle()),uint8(T.Lifecycle.TERMINATED));uint256 treasury=RECOVERY_TREASURY.balance;vm.prank(GUARDIAN);recovery.recoverProtocol(id);assertEq(kernel.protocolReserve(),0);assertEq(RECOVERY_TREASURY.balance-treasury,0.01 ether);}
    function testBuybackPolicyNeverExecutesWhileQuoteRulesUnresolved() public { _openAndClose(1 ether,3 ether,1);vm.expectRevert(CompdVaultKernelV2.QuotePolicyUnavailable.selector);vm.prank(AUTOMATION);buyback.attemptRelease(keccak256("op"),0.05 ether,keccak256("q"));assertEq(kernel.buybackReserve(),0.3 ether);assertEq(address(buyExec).balance,0); }
    function testSettlementReturnMismatchRollsBack() public {_openAndClose(1 ether,1.1 ether,1);vm.prank(AUTOMATION);settlement.startRun(2,address(0xA11CE),1 ether,keccak256("a2"));vm.prank(AUTOMATION);settlement.requestExit(2,keccak256("e2"));executor.setMismatch(1.1 ether,1 ether);uint256 sc=kernel.strategyCapital();vm.expectRevert();vm.prank(AUTOMATION);settlement.closeRun(2,keccak256("c2"));assertEq(kernel.strategyCapital(),sc);assertEq(kernel.runPrincipal(2),1 ether);}
    function testFuzzProfitSplitConservesAccounting(uint64 seed) public {uint256 profit=bound(uint256(seed),0,1 ether);_openAndClose(1 ether,1 ether+profit,1);assertEq(kernel.strategyCapital()+kernel.buybackReserve()+kernel.protocolReserve()+kernel.holderRewardReserve(),kernel.accountedQuote()+kernel.activePrincipal());assertLe(kernel.activePrincipal(),kernel.strategyCapital());assertGe(kernel.accountedQuote(),kernel.holderRewardReserve());}
    function testFuzzPrincipalIsNotProfit(uint96 seed) public {uint256 p=bound(uint256(seed),1,1 ether);_openAndClose(p,p,1);assertEq(kernel.cumulativeRealizedProfit(),0);assertEq(kernel.strategyCapital(),10 ether);assertEq(kernel.buybackReserve(),0);}
    function testHolderSuccessCannotReplay() public {_openAndClose(1 ether,1.1 ether,1);(T.HolderPayment memory p,)=_payment(address(this),0.005 ether);vm.prank(AUTOMATION);assertTrue(holder.pay(p.leafId));vm.expectRevert();vm.prank(AUTOMATION);holder.pay(p.leafId);assertTrue(kernel.holderPaid(p.useId));}
    function testHolderAmountAboveReserveRejected() public {_openAndClose(1 ether,1.1 ether,1);(T.HolderPayment memory p,bytes32 d)=_payment(address(this),0.02 ether);vm.expectRevert();vm.prank(AUTOMATION);holder.pay(p.leafId);assertFalse(kernel.holderPaid(p.useId));d;}
    function testUnauthorizedKernelCapabilityAndRebindingRejected() public {vm.expectRevert();vm.prank(address(0xBAD));kernel.allocateStrategyPrincipal(1,address(0xA11CE),1 ether,keccak256("x"));address[6] memory mods=[address(settlement),address(holder),address(buyback),address(recovery),address(emergency),address(registry)];vm.expectRevert();vm.prank(ADMIN);kernel.bindModules(mods);}
    function testEmergencyEntryUnauthorizedRejected() public {vm.expectRevert();vm.prank(address(0xBAD));kernel.emergencyEnter();assertEq(uint8(kernel.lifecycle()),uint8(T.Lifecycle.ACTIVE));}
    function testPositionAndAggregateExposureCaps() public {vm.expectRevert();vm.prank(AUTOMATION);settlement.startRun(1,address(0xA11CE),1.01 ether,keccak256("too-large"));for(uint256 i;i<3;i++){vm.prank(AUTOMATION);settlement.startRun(i+1,address(0xA11CE),1 ether,keccak256(abi.encode(i)));}vm.expectRevert();vm.prank(AUTOMATION);settlement.startRun(4,address(0xA11CE),1 wei,keccak256("fourth"));}
    function testFuzzHolderMutationIsRejected(uint64 rawDelta) public {_openAndClose(1 ether,1.1 ether,1);(T.HolderPayment memory p,bytes32 d)=_payment(address(this),0.001 ether);T.HolderPayment memory bad=p;bad.amount+=bound(uint256(rawDelta),1,1e9);dist.set(bad,d);vm.expectRevert();vm.prank(AUTOMATION);holder.pay(p.leafId);assertFalse(kernel.holderPaid(p.useId));}
    function testDrawdownBreakerLatchesAcrossUtcDays() public {uint64 day=uint64(block.timestamp/1 days);_openAndClose(1 ether,0.6 ether,1);assertFalse(settlement.riskLatched());vm.warp(uint256(day+1)*1 days+1);_openAndClose(0.96 ether,0.56 ether,2);assertFalse(settlement.riskLatched());vm.warp(uint256(day+2)*1 days+1);_openAndClose(0.92 ether,0.52 ether,3);assertTrue(settlement.riskLatched());}
    function testDuplicateRunRejected() public {vm.prank(AUTOMATION);settlement.startRun(1,address(0xA11CE),1 ether,keccak256("a"));vm.prank(AUTOMATION);vm.expectRevert();settlement.startRun(1,address(0xA11CE),1 ether,keccak256("b"));}
    receive() external payable {}
}
