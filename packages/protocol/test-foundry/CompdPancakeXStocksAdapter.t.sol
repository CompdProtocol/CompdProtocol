pragma solidity ^0.8.37;
import {Test} from "forge-std/Test.sol";
import {CompdPancakeXStocksAdapterV3 as A, IXStockIndependentGuard} from "../contracts/production/v3/phase7cr2ch/CompdPancakeXStocksAdapterV3.sol";
import {CompdStrategyExecutorV2R2 as E} from "../contracts/production/v2/phase7ar2/CompdStrategyExecutorV2R2.sol";
import {C2G2BTypes as T} from "../contracts/production/v2/phase7ar2/C2G2BTypesR2.sol";
contract XTokenFixture {mapping(address=>uint256) public balanceOf;mapping(address=>mapping(address=>uint256)) public allowance;function sharesOf(address a) external view returns(uint256){return balanceOf[a];}function getSharesByUnderlyingAmount(uint256 n) external pure returns(uint256){return n;}function getUnderlyingAmountByShares(uint256 n) external pure returns(uint256){return n;}function transferShares(address to,uint256 n) external returns(bool){balanceOf[msg.sender]-=n;balanceOf[to]+=n;return true;}function mint(address a,uint256 n) external {balanceOf[a]+=n;}function approve(address a,uint256 n) external returns(bool){allowance[msg.sender][a]=n;return true;}function transferFrom(address a,address b,uint256 n) external returns(bool){require(allowance[a][msg.sender]>=n);allowance[a][msg.sender]-=n;balanceOf[a]-=n;balanceOf[b]+=n;return true;}}
contract XPairFixture {address public token0;address public token1;uint112 public reserve;constructor(address a,address b){token0=a;token1=b;reserve=uint112(1000 ether);}function setReserve(uint112 r) external {reserve=r;}function getReserves() external view returns(uint112,uint112,uint32){return(reserve,reserve,0);}}
contract XFactoryFixture {address public pair;constructor(address p){pair=p;}mapping(bytes32=>address) private bound;function setPair(address a,address b,address p) external {bound[keccak256(abi.encode(a,b))]=p;bound[keccak256(abi.encode(b,a))]=p;}function getPair(address a,address b) external view returns(address){address p=bound[keccak256(abi.encode(a,b))];return p==address(0)?pair:p;}}
contract XRouterFixture {address public factory;address public WETH;uint256 public rate;bool public fail;function init(address f,address w) external {factory=f;WETH=w;rate=10000;}function setRate(uint256 r) external {rate=r;}function setFail(bool f) external {fail=f;}function getAmountsOut(uint256 n,address[] calldata path) external view returns(uint256[] memory x){x=new uint256[](path.length);x[0]=n;for(uint256 i=1;i<path.length;i++)x[i]=x[i-1]*rate/10000;}
function swapExactETHForTokensSupportingFeeOnTransferTokens(uint256 min,address[] calldata path,address to,uint256 deadline) external payable {require(!fail&&deadline>=block.timestamp);uint256 n=msg.value*rate/10000;require(n>=min);XTokenFixture(path[path.length-1]).mint(to,n);}
function swapExactTokensForETHSupportingFeeOnTransferTokens(uint256 n,uint256 min,address[] calldata path,address to,uint256 deadline) external {require(!fail&&deadline>=block.timestamp);XTokenFixture(path[0]).transferFrom(msg.sender,address(this),n);uint256 out=n*rate/10000;require(out>=min);(bool ok,)=payable(to).call{value:out}("");require(ok);}}
contract XGuardFixture is IXStockIndependentGuard {uint256 public rate=10000;uint64 public age;bool public opened=true;function configure(uint256 r,uint64 a,bool o) external {rate=r;age=a;opened=o;}function referenceOut(address,bool,uint256 n) external view returns(uint256,uint64,uint64,bool){return(n*rate/10000,uint64(block.timestamp)-age,uint64(block.timestamp)+60,opened);}}
contract XKernelFixture {T.Lifecycle public lifecycle=T.Lifecycle.PAUSED;bool public hasActivated=true;E public executor;constructor(){executor=new E(address(this),msg.sender,msg.sender);}receive() external payable {}function open(A a,uint256 run,uint256 n) external returns(bytes32){return executor.openRun{value:n}(run,address(a),n,n*300/10000,bytes32(run));}function exit(uint256 r,bytes32 e) external {executor.requestExit(r,e);}function close(uint256 r) external returns(uint256,uint256,bytes32){return executor.closeToKernel(r,bytes32(r+100));}}
contract CompdPancakeXStocksAdapterTest is Test {
 address constant ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E;address constant WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c;address constant TOKEN=0x8aD3c73F833d3F9A523aB01476625F269aEB7Cf0;
 A a;XKernelFixture k;E e;XGuardFixture g;XPairFixture pair;XTokenFixture t;XRouterFixture r;
 function setUp() public {vm.chainId(56);vm.warp(100000);XTokenFixture impl=new XTokenFixture();vm.etch(TOKEN,address(impl).code);t=XTokenFixture(TOKEN);pair=new XPairFixture(WBNB,TOKEN);XFactoryFixture f=new XFactoryFixture(address(pair));XRouterFixture routerImpl=new XRouterFixture();vm.etch(ROUTER,address(routerImpl).code);r=XRouterFixture(ROUTER);r.init(address(f),WBNB);g=new XGuardFixture();k=new XKernelFixture();e=k.executor();a=new A(address(e),1,address(0),address(g));e.proposeStrategy(address(a),a.strategyIdentity(),a.riskConfigCommitment(),a.venueDependencyCommitment());vm.warp(block.timestamp+24 hours);e.activateStrategy(address(a));vm.deal(address(k),10 ether);vm.deal(ROUTER,10 ether);}
 function testActualExecutorBuySellPhysicalProfit() public {bytes32 id=k.open(a,1,1 ether);assertEq(t.balanceOf(address(a)),1 ether);r.setRate(10200);g.configure(10200,0,true);k.exit(1,bytes32(uint256(22)));assertEq(t.balanceOf(address(a)),0);assertEq(t.allowance(address(a),ROUTER),0);uint256 beforeBalance=address(k).balance;(uint256 principal,uint256 returned,)=k.close(1);assertEq(principal,1 ether);assertEq(returned,1.02 ether);assertEq(address(k).balance-beforeBalance,returned);assertEq(uint256(e.runState(1)),uint256(T.StrategyRunState.CLOSED));(,,,,,bool closed)=a.positions(id);assertTrue(closed);}
 function testLossPhysicalSettlement() public {k.open(a,1,1 ether);r.setRate(9800);g.configure(9800,0,true);k.exit(1,bytes32(uint256(22)));(,uint256 returned,)=k.close(1);assertEq(returned,.98 ether);}
 function testUnauthorizedEntry() public {vm.expectRevert(A.Unauthorized.selector);a.open{value:0}(1,bytes32(uint256(1)),1,0);}
 function testStaleOracleEntryFailsAtomic() public {g.configure(10000,61,true);vm.expectRevert(A.Unavailable.selector);k.open(a,1,1 ether);assertEq(address(k).balance,10 ether);assertEq(t.balanceOf(address(a)),0);}
 function testClosedMarketFails() public {g.configure(10000,0,false);vm.expectRevert(A.Unavailable.selector);k.open(a,1,1 ether);}
 function testNoIndependentPriceFails() public {g.configure(0,0,true);vm.expectRevert(A.Unavailable.selector);k.open(a,1,1 ether);}
 function testQuoteDeviationFails() public {r.setRate(9600);vm.expectRevert(A.Unavailable.selector);k.open(a,1,1 ether);}
 function testThinLiquidityFails() public {pair.setReserve(uint112(50 ether));vm.expectRevert(A.Unavailable.selector);k.open(a,1,1 ether);}
 function testChangedRouterFails() public {vm.etch(ROUTER,hex"00");vm.expectRevert(A.Unavailable.selector);k.open(a,1,1 ether);}
 function testBuyRevertRollsBack() public {r.setFail(true);vm.expectRevert();k.open(a,1,1 ether);assertEq(address(k).balance,10 ether);assertEq(t.balanceOf(address(a)),0);r.setFail(false);k.open(a,1,1 ether);}
 function testExitFailureRetainsCustodyAndRetry() public {k.open(a,1,1 ether);r.setFail(true);k.exit(1,bytes32(uint256(22)));assertEq(t.balanceOf(address(a)),1 ether);assertEq(t.allowance(address(a),ROUTER),0);assertEq(uint256(e.runState(1)),uint256(T.StrategyRunState.BLOCKED));r.setFail(false);k.exit(1,bytes32(uint256(22)));k.close(1);assertEq(t.balanceOf(address(a)),0);}
 function testDuplicateEntryAndCloseRejected() public {k.open(a,1,1 ether);vm.expectRevert();k.open(a,1,1 ether);k.exit(1,bytes32(uint256(22)));k.close(1);vm.expectRevert();k.close(1);}
 function testPartialCollectionDoesNotPrematurelyCredit() public {k.open(a,1,1 ether);k.exit(1,bytes32(uint256(22)));vm.prank(address(k));assertEq(e.collectPartial(1,bytes32(uint256(33)),1 ether),0);(,uint256 returned,)=k.close(1);assertEq(returned,1 ether);}
 function testAccidentalTokenNotSold() public {t.mint(address(a),2 ether);k.open(a,1,1 ether);k.exit(1,bytes32(uint256(22)));k.close(1);assertEq(t.balanceOf(address(a)),2 ether);}
 function testTwoPositionsSeparateCustody() public {k.open(a,1,1 ether);k.open(a,2,1 ether);k.exit(1,bytes32(uint256(22)));k.close(1);assertEq(t.balanceOf(address(a)),1 ether);k.exit(2,bytes32(uint256(23)));k.close(2);assertEq(t.balanceOf(address(a)),0);}
 function testFixedStablecoinMultihopBuySell() public {address stable=a.USDT();XFactoryFixture f=new XFactoryFixture(address(0));f.setPair(WBNB,stable,address(new XPairFixture(WBNB,stable)));f.setPair(stable,TOKEN,address(new XPairFixture(stable,TOKEN)));r.init(address(f),WBNB);A multi=new A(address(e),1,stable,address(g));e.proposeStrategy(address(multi),multi.strategyIdentity(),multi.riskConfigCommitment(),multi.venueDependencyCommitment());vm.warp(block.timestamp+24 hours);e.activateStrategy(address(multi));k.open(multi,1,1 ether);k.exit(1,bytes32(uint256(22)));(,uint256 received,)=k.close(1);assertEq(received,1 ether);}
 function testUnauthorizedExitAndClose() public {bytes32 id=k.open(a,1,1 ether);vm.expectRevert(A.Unauthorized.selector);a.requestExit(id,bytes32(uint256(22)));vm.expectRevert(A.Unauthorized.selector);a.close(id,bytes32(uint256(33)));}
 function testDisabledAdapterStillAllowsExistingExit() public {k.open(a,1,1 ether);e.disableStrategy(address(a));assertFalse(e.isApprovedStrategy(address(a)));k.exit(1,bytes32(uint256(22)));k.close(1);}
 function testClosedMarketExitRetainsPositionForRetry() public {k.open(a,1,1 ether);g.configure(10000,0,false);k.exit(1,bytes32(uint256(22)));assertEq(t.balanceOf(address(a)),1 ether);assertEq(uint256(e.runState(1)),uint256(T.StrategyRunState.BLOCKED));g.configure(10000,0,true);k.exit(1,bytes32(uint256(22)));k.close(1);}
 function testAllFiveExactTokenIdentitiesWithLabeledFixtures() public {address[5] memory assets=[address(0xc845b2894dBddd03858fd2D643B4eF725fE0849d),TOKEN,address(0x3557Ba345B01EFa20A1bdDC61F573BFD87195081),address(0x9d275685dC284C8eB1C79f6ABA7a63Dc75ec890a),address(0x90A2a4c76b5D8c0bc892A69EA28Aa775a8f2dD48)];for(uint8 i;i<5;i++){XTokenFixture impl=new XTokenFixture();vm.etch(assets[i],address(impl).code);XFactoryFixture f=new XFactoryFixture(address(new XPairFixture(WBNB,assets[i])));r.init(address(f),WBNB);A instance=new A(address(e),i,address(0),address(g));assertEq(instance.token(),assets[i]);}}}

