pragma solidity ^0.8.37;
import {Test} from "forge-std/Test.sol";
import {CompdPancakeXStocksAdapterV3 as A} from "../contracts/production/v3/phase7cr2ch/CompdPancakeXStocksAdapterV3.sol";
import {XTokenFixture,XPairFixture,XFactoryFixture,XRouterFixture,XGuardFixture} from "./CompdPancakeXStocksAdapter.t.sol";
import {T,Kernel,Settlement,StrategyExecutor} from "./phase7cr2ci/Phase7CR2CISettlementLifecycle.t.sol";
import {MatrixModuleDeployer,MatrixKernelDeployer} from "./phase7cr2ci/Phase7CR2CIValidationMatrix.t.sol";
import {XRebaseFixture} from "./CompdPancakeRebaseQualification.t.sol";
contract CompdPancakeXStocksKernelTest is Test {
 address constant ADMIN=0x7Ea65A566e08862ebaFabF564A7A069E10DFd5e9;address constant GUARDIAN=0x34c5F07750aC19ff28d73FE039456Aa11e2f8eC1;address constant AGENT=0xB878884A07Fc84e6A1336e15CA8C6580cD7164c3;
 address constant ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E;address constant WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c;address constant TOKEN=0x8aD3c73F833d3F9A523aB01476625F269aEB7Cf0;
 Kernel kernel;Settlement settlement;A a;XGuardFixture g;XRouterFixture router;
 function setUp() public {vm.chainId(56);vm.roll(1000);vm.warp(100 days+123);MatrixModuleDeployer md=new MatrixModuleDeployer();MatrixKernelDeployer kd=new MatrixKernelDeployer();address k=vm.computeCreateAddress(address(kd),1);address s=vm.computeCreateAddress(address(md),2);address d=vm.computeCreateAddress(address(md),3);address l=vm.computeCreateAddress(address(md),4);address e=vm.computeCreateAddress(address(md),5);address c=md.candidate(k,s,d,address(0xF1A1),address(0x70C0));s=md.state(k,d,l,e,address(0xF1A1),c,address(0x70C0),c.codehash);d=md.distributor(k,s,c,address(0xF1A1));l=md.liability(k,s);e=md.evidence(k,s);address recovery=md.recovery(k,e,e.codehash);address holder=md.holder(k,d,l,s);address probe=address(new StrategyExecutor(k,ADMIN,GUARDIAN));address executor=vm.computeCreateAddress(k,1);address settle=md.settlement(k,executor,probe.codehash);address policy=md.policy(k);address em=md.emergency(k,vm.computeCreateAddress(address(md),11));address registry=md.registry(k,em);address bb=md.buyback(k);address[6] memory modules=[settle,holder,policy,recovery,em,registry];bytes32[13] memory hashes=[probe.codehash,bb.codehash,d.codehash,l.codehash,e.codehash,c.codehash,s.codehash,settle.codehash,holder.codehash,policy.codehash,recovery.codehash,em.codehash,registry.codehash];kernel=Kernel(payable(kd.deploy(GUARDIAN,kernelAddressRecovery(),bb,d,l,e,c,address(0x70C0),modules,hashes)));settlement=Settlement(settle);
 vm.deal(ADMIN,100 ether);vm.prank(ADMIN);kernel.bootstrapTreasury{value:100 ether}();vm.prank(ADMIN);kernel.activate();uint64 activation=kernel.activationBlock();vm.roll(uint256(activation)+1);vm.setBlockhash(activation,keccak256("LOCAL_XSTOCKS_FIXTURE_HEADER"));assertTrue(kernel.sealActivationCheckpoint());vm.prank(GUARDIAN);kernel.pause();
 XTokenFixture tokenImpl=new XTokenFixture();vm.etch(TOKEN,address(tokenImpl).code);XPairFixture pair=new XPairFixture(WBNB,TOKEN);XFactoryFixture factory=new XFactoryFixture(address(pair));XRouterFixture routerImpl=new XRouterFixture();vm.etch(ROUTER,address(routerImpl).code);router=XRouterFixture(ROUTER);router.init(address(factory),WBNB);vm.deal(ROUTER,100 ether);g=new XGuardFixture();a=new A(kernel.strategyExecutor(),1,address(0),address(g));StrategyExecutor exec=StrategyExecutor(payable(kernel.strategyExecutor()));bytes32 identity=a.strategyIdentity();bytes32 risk=a.riskConfigCommitment();bytes32 venue=a.venueDependencyCommitment();vm.prank(ADMIN);exec.proposeStrategy(address(a),identity,risk,venue);vm.warp(block.timestamp+24 hours);vm.prank(ADMIN);exec.activateStrategy(address(a));vm.prank(GUARDIAN);kernel.resume();vm.warp((block.timestamp/28800+1)*28800+1);
 }
 function kernelAddressRecovery() private pure returns(address){return 0xFa8706AA97B07cb29096381f9101784bA0d1332b;}
 function start(uint256 id,uint256 n) internal {vm.prank(AGENT);settlement.startRun(id,address(a),n,bytes32(id));}
 function exitClose(uint256 id) internal {vm.prank(AGENT);settlement.requestExit(id,bytes32(id+100));vm.prank(AGENT);settlement.closeRun(id,bytes32(id+200));}
 function testXStocksKernelPhysicalProfitAllocation() public {start(1,1 ether);router.setRate(10200);g.configure(10200,0,true);exitClose(1);assertEq(kernel.cumulativeRealizedProfit(),.02 ether);assertEq(kernel.strategyCapital(),10.013 ether);assertEq(kernel.buybackReserve(),.003 ether);assertEq(kernel.holderRewardReserve(),.002 ether);assertEq(kernel.protocolReserve(),.002 ether);assertEq(kernel.nonStrategyTreasuryPrincipal(),90 ether);assertEq(kernel.activePrincipal(),0);assertEq(kernel.accountedQuote(),100.02 ether);assertEq(address(kernel).balance,100.02 ether);}
 function testXStocksKernelExposureAndShutdown() public {vm.expectRevert();start(1,1 ether+1);start(1,1 ether);start(2,1 ether);start(3,1 ether);vm.expectRevert();start(4,1);assertEq(kernel.activeRunCount(),3);assertEq(kernel.activePrincipal(),3 ether);vm.prank(GUARDIAN);kernel.emergencyShutdown();vm.expectRevert();start(5,1);exitClose(1);exitClose(2);exitClose(3);assertEq(kernel.activePrincipal(),0);assertEq(kernel.accountedQuote(),100 ether);}
 function testXStocksKernelLossDoesNotInventRewards() public {start(1,1 ether);router.setRate(9800);g.configure(9800,0,true);exitClose(1);assertEq(kernel.cumulativeRealizedLoss(),.02 ether);assertEq(kernel.strategyCapital(),9.98 ether);assertEq(kernel.holderRewardReserve(),0);assertEq(kernel.buybackReserve(),0);assertFalse(kernel.strategyAllocationHalted());}
 function rebaseMarket() private returns(XRebaseFixture token){
  vm.prank(GUARDIAN);kernel.pause();XRebaseFixture impl=new XRebaseFixture();vm.etch(TOKEN,address(impl).code);token=XRebaseFixture(TOKEN);token.setIndex(1 ether);a=new A(kernel.strategyExecutor(),1,address(0),address(g));
  StrategyExecutor exec=StrategyExecutor(payable(kernel.strategyExecutor()));bytes32 identity=a.strategyIdentity();bytes32 risk=a.riskConfigCommitment();bytes32 venue=a.venueDependencyCommitment();vm.prank(ADMIN);exec.proposeStrategy(address(a),identity,risk,venue);vm.warp(block.timestamp+24 hours);vm.prank(ADMIN);exec.activateStrategy(address(a));vm.prank(GUARDIAN);kernel.resume();vm.warp((block.timestamp/28800+1)*28800+1);
 }
 function testXStocksKernelRebaseProfitSettlesActualNativeProceeds() public {
  XRebaseFixture token=rebaseMarket();start(1,1 ether);token.setIndex(1.02 ether);exitClose(1);assertEq(token.sharesOf(address(a)),0);assertEq(kernel.cumulativeRealizedProfit(),.02 ether);assertEq(kernel.strategyCapital(),10.013 ether);assertEq(kernel.buybackReserve(),.003 ether);assertEq(kernel.holderRewardReserve(),.002 ether);assertEq(kernel.protocolReserve(),.002 ether);assertEq(kernel.nonStrategyTreasuryPrincipal(),90 ether);assertEq(kernel.activePrincipal(),0);assertEq(kernel.accountedQuote(),100.02 ether);assertEq(address(kernel).balance,100.02 ether);
 }
 function testXStocksKernelRebaseLossDoesNotCreateProfitOrRewards() public {
  XRebaseFixture token=rebaseMarket();start(1,1 ether);token.setIndex(.98 ether);exitClose(1);assertEq(token.sharesOf(address(a)),0);assertEq(kernel.cumulativeRealizedLoss(),.02 ether);assertEq(kernel.cumulativeRealizedProfit(),0);assertEq(kernel.strategyCapital(),9.98 ether);assertEq(kernel.holderRewardReserve(),0);assertEq(kernel.buybackReserve(),0);assertEq(kernel.accountedQuote(),99.98 ether);assertEq(address(kernel).balance,99.98 ether);
 }

}

