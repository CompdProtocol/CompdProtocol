pragma solidity ^0.8.37;
import {C2G2BTypes as T, IC2G2BKernel, IC2G2BStrategyExecutor} from "./C2G2BTypes.sol";
interface IKernelSettlementConfig { function strategyExecutor() external view returns(address); function strategyExecutorHash() external view returns(bytes32); function runPrincipal(uint256) external view returns(uint256); function strategyCapital() external view returns(uint256); function cumulativeRealizedLoss() external view returns(uint256); }
contract CompdSettlementModuleV2 {
    uint8 public constant MODULE_ID=0; uint32 public constant MODULE_VERSION=2;
    address public immutable kernel; address public immutable strategyExecutor; bytes32 public immutable executorHash;
    struct Run { address strategy; uint256 principal; uint64 openedAt; uint64 lastTransitionAt; bytes32 allocationId; bytes32 exitId; bytes32 closeId; T.RunStatus status; }
    mapping(uint256=>Run) private _runs; uint256[] private _history; bool private _entered; bool public riskLatched; bool private _riskInitialized; uint64 private _riskDay; uint256 private _dayCapital; uint256 private _dayLossStart; uint256 public peakStrategyCapital;
    error Unauthorized(); error InvalidRun(); error ChangedCode(); error ExternalFailure();
    event RunOpened(uint256 indexed runId,address indexed strategy,uint256 principal,bytes32 allocationId);
    event ExitTransition(uint256 indexed runId,bytes32 indexed exitId,T.RunStatus status);
    event RunClosed(uint256 indexed runId,bytes32 indexed closeId,T.RunStatus status); event RiskBreakerLatched(uint256 dailyLoss,uint256 dayCapital,uint256 drawdown,uint256 peakCapital);
    modifier lock(){if(_entered)revert Unauthorized();_entered=true;_;_entered=false;}
    constructor(address kernel_,address executor_){if(kernel_==address(0)||executor_.code.length==0||IKernelSettlementConfig(kernel_).strategyExecutor()!=executor_)revert Unauthorized();kernel=kernel_;strategyExecutor=executor_;executorHash=_hash(executor_);if(IKernelSettlementConfig(kernel_).strategyExecutorHash()!=executorHash)revert Unauthorized();}
    function moduleId() external pure returns(uint8){return MODULE_ID;} function moduleVersion() external pure returns(uint32){return MODULE_VERSION;}
    function startRun(uint256 id,address strategy,uint256 amount,bytes32 allocationId) external lock {if(msg.sender!=_automation()||id==0||_runs[id].status!=T.RunStatus.NONE||strategy==address(0)||amount==0||allocationId==0)revert Unauthorized();_syncRisk();if(riskLatched)revert InvalidRun();_checkExecutor();if(!IC2G2BStrategyExecutor(strategyExecutor).isApprovedStrategy(strategy))revert InvalidRun();IC2G2BKernel(kernel).allocateStrategyPrincipal(id,strategy,amount,allocationId);_runs[id]=Run(strategy,amount,uint64(block.timestamp),uint64(block.timestamp),allocationId,0,0,T.RunStatus.OPEN);_history.push(id);emit RunOpened(id,strategy,amount,allocationId);}
    function requestExit(uint256 id,bytes32 exitId) external lock {if(msg.sender!=_automation()&&msg.sender!=_guardian())revert Unauthorized();Run storage r=_runs[id];if((r.status!=T.RunStatus.OPEN&&r.status!=T.RunStatus.BLOCKED)||exitId==0)revert InvalidRun();_checkExecutor();T.RunStatus s=IC2G2BStrategyExecutor(strategyExecutor).requestExit(id,exitId);if(s!=T.RunStatus.EXIT_REQUESTED&&s!=T.RunStatus.RETURN_PENDING&&s!=T.RunStatus.BLOCKED)revert ExternalFailure();r.exitId=exitId;r.status=s;r.lastTransitionAt=uint64(block.timestamp);emit ExitTransition(id,exitId,s);}
    function closeRun(uint256 id,bytes32 closeId) external lock {if(msg.sender!=_automation()&&msg.sender!=_guardian())revert Unauthorized();Run storage r=_runs[id];if((r.status!=T.RunStatus.EXIT_REQUESTED&&r.status!=T.RunStatus.RETURN_PENDING)||closeId==0||IKernelSettlementConfig(kernel).runPrincipal(id)!=r.principal)revert InvalidRun();IC2G2BKernel(kernel).settleStrategyPrincipal(id,closeId);_syncRisk();r.closeId=closeId;r.status=T.RunStatus.SETTLED;r.lastTransitionAt=uint64(block.timestamp);emit RunClosed(id,closeId,r.status);}
    function recordBlocked(uint256 id,bytes32 evidence) external {if(msg.sender!=_guardian()||evidence==0)revert Unauthorized();Run storage r=_runs[id];if(r.status!=T.RunStatus.OPEN&&r.status!=T.RunStatus.EXIT_REQUESTED&&r.status!=T.RunStatus.RETURN_PENDING)revert InvalidRun();r.status=T.RunStatus.BLOCKED;r.lastTransitionAt=uint64(block.timestamp);emit ExitTransition(id,evidence,r.status);}
    function run(uint256 id) external view returns(Run memory){return _runs[id];} function historyLength() external view returns(uint256){return _history.length;} function historyAt(uint256 i) external view returns(uint256){return _history[i];}
    function riskState() external view returns(bool,uint64,uint256,uint256,uint256){return(riskLatched,_riskDay,_dayCapital,_dayLossStart,peakStrategyCapital);}
    function terminationReady() external view returns(bool){for(uint256 i;i<_history.length;++i){T.RunStatus s=_runs[_history[i]].status;if(s!=T.RunStatus.SETTLED&&s!=T.RunStatus.BLOCKED)return false;}return true;}
    function _syncRisk() private {uint256 sc=IKernelSettlementConfig(kernel).strategyCapital();uint256 losses=IKernelSettlementConfig(kernel).cumulativeRealizedLoss();uint64 day=uint64(block.timestamp/1 days);if(!_riskInitialized||day!=_riskDay){_riskInitialized=true;_riskDay=day;_dayCapital=sc;_dayLossStart=losses;}if(sc>peakStrategyCapital)peakStrategyCapital=sc;uint256 dl=losses>=_dayLossStart?losses-_dayLossStart:0;uint256 dd=peakStrategyCapital>sc?peakStrategyCapital-sc:0;if((_dayCapital!=0&&dl*10_000>=_dayCapital*500)||(peakStrategyCapital!=0&&dd*10_000>=peakStrategyCapital*1_000)){riskLatched=true;emit RiskBreakerLatched(dl,_dayCapital,dd,peakStrategyCapital);}}
    function _automation() private pure returns(address){return 0xB878884A07Fc84e6A1336e15CA8C6580cD7164c3;} function _guardian() private pure returns(address){return 0x34c5F07750aC19ff28d73FE039456Aa11e2f8eC1;} function _checkExecutor() private view {if(_hash(strategyExecutor)!=executorHash)revert ChangedCode();} function _hash(address a) private view returns(bytes32 h){assembly{h:=extcodehash(a)}}
}
