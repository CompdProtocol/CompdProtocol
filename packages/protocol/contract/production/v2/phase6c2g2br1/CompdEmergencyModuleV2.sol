pragma solidity ^0.8.37;
import {C2G2BTypes as T,IC2G2BKernel,IC2G2BRegistry} from "./C2G2BTypes.sol";
interface IEmergencyModuleConfig {function emergencyAuthority() external view returns(address);function emergencyWallet() external view returns(address);}
interface IEmergencyRegistryBackref {function initialized() external view returns(bool);function kernel() external view returns(address);function moduleId() external view returns(uint8);function moduleVersion() external view returns(uint32);function bindEmergencyModule(address) external;}
contract CompdEmergencyModuleV2 {
    uint8 public constant MODULE_ID=4;uint32 public constant MODULE_VERSION=2;address public immutable kernel;address public immutable registry;bytes32 public immutable registryHash;bool public _entered;
    error Unauthorized();error InvalidState();error ChangedCode();event RegistryInitialized(bytes32 indexed snapshotId,uint256 scopes);event EmergencyStatus(T.ProcessingStatus status);event RecoveryAttempt(bytes32 indexed scopeId,bytes32 indexed attemptId,uint256 amount);
    modifier lock(){if(_entered)revert Unauthorized();_entered=true;_;_entered=false;}
    constructor(address kernel_,address registry_){if(kernel_==address(0)||registry_.code.length==0||IEmergencyRegistryBackref(registry_).kernel()!=kernel_||IEmergencyRegistryBackref(registry_).moduleId()!=5||IEmergencyRegistryBackref(registry_).moduleVersion()!=2)revert Unauthorized();kernel=kernel_;registry=registry_;registryHash=_hash(registry_);}
    function moduleId() external pure returns(uint8){return MODULE_ID;}function moduleVersion() external pure returns(uint32){return MODULE_VERSION;}
    function initialize(bytes32[] calldata ids,uint8[] calldata kinds) external {if(msg.sender!=_authority())revert Unauthorized();_check();bytes32 snap=IC2G2BKernel(kernel).emergencySnapshotId();if(IC2G2BKernel(kernel).lifecycle()!=T.Lifecycle.EMERGENCY_RECOVERY)revert InvalidState();IC2G2BRegistry(registry).initialize(snap,ids,kinds);emit RegistryInitialized(snap,ids.length);_updateStatus();}
    function recoverBNB(bytes32 scopeId,bytes32 attemptId,uint32 number,uint256 amount,bytes32 evidence) external lock {if(msg.sender!=_authority()||IC2G2BKernel(kernel).lifecycle()!=T.Lifecycle.EMERGENCY_RECOVERY)revert Unauthorized();_check();IC2G2BKernel(kernel).emergencyTransferBNB(scopeId,attemptId,number,amount,evidence);emit RecoveryAttempt(scopeId,attemptId,amount);_updateStatus();}
    function beginWorkflowAttempt(bytes32 scopeId,bytes32 attemptId,uint32 number) external {if(msg.sender!=_authority())revert Unauthorized();_check();IC2G2BRegistry(registry).beginWorkflowAttempt(IC2G2BKernel(kernel).emergencySnapshotId(),scopeId,attemptId,number);_updateStatus();}
    function finishWorkflowAttempt(bytes32 scopeId,bytes32 attemptId,uint32 number,T.AttemptStatus status,bytes32 evidence) external {if(msg.sender!=_authority())revert Unauthorized();_check();IC2G2BRegistry(registry).finishWorkflowAttempt(IC2G2BKernel(kernel).emergencySnapshotId(),scopeId,attemptId,number,status,evidence);_updateStatus();}    function discover(bytes32 scopeId,uint8 kind,bytes32 evidence) external {if(msg.sender!=_authority())revert Unauthorized();_check();IC2G2BRegistry(registry).lateDiscovery(IC2G2BKernel(kernel).emergencySnapshotId(),scopeId,kind,evidence);_updateStatus();}
    function resolve(bytes32 scopeId,bytes32 evidence) external {if(msg.sender!=_authority())revert Unauthorized();_check();IC2G2BRegistry(registry).resolve(IC2G2BKernel(kernel).emergencySnapshotId(),scopeId,evidence);_updateStatus();}
    function _updateStatus() private { (,uint256 open,uint256 pending,uint256 blocked,)=IC2G2BRegistry(registry).summary(IC2G2BKernel(kernel).emergencySnapshotId());if(!IEmergencyRegistryBackref(registry).initialized())revert InvalidState();T.ProcessingStatus s;if(open==0&&pending==0&&blocked==0)s=T.ProcessingStatus.COMPLETE_WITHIN_REGISTERED_SCOPE;else if(open==0&&pending==0&&blocked>0)s=T.ProcessingStatus.COMPLETE_WITH_UNRESOLVED;else s=T.ProcessingStatus.IN_PROGRESS;IC2G2BKernel(kernel).setEmergencyStatus(s);emit EmergencyStatus(s);}
    function terminationReady() external pure returns(bool){return true;}
    function _authority() private view returns(address){return IEmergencyModuleConfig(kernel).emergencyAuthority();}function _check() private view {if(_hash(registry)!=registryHash)revert ChangedCode();}function _hash(address a) private view returns(bytes32 h){assembly{h:=extcodehash(a)}}
}
