pragma solidity ^0.8.37;
import {C2G2BTypes as T,IC2G2BRegistry} from "./C2G2BTypes.sol";
interface IEmergencyRegistryAdmin {function CONFIGURATION_ADMIN() external view returns(address);function lifecycle() external view returns(T.Lifecycle);function modulesBound() external view returns(bool);}
interface IRegistryModule {function kernel() external view returns(address);function moduleId() external view returns(uint8);function moduleVersion() external view returns(uint32);}
interface IEmergencyRegistryKernel {function emergencySnapshotId() external view returns(bytes32);function lifecycle() external view returns(T.Lifecycle);}
contract CompdEmergencyScopeRegistryV2 is IC2G2BRegistry {
    address public immutable kernel;address public emergencyModule;bytes32 public emergencyModuleHash;
    struct Scope {T.ScopeKind kind;T.ScopeStatus status;bytes32 evidence;uint32 lastAttempt;}
    mapping(bytes32=>Scope) private _scopes;bytes32[] private _ids;mapping(bytes32=>mapping(bytes32=>T.Attempt)) private _attempts;mapping(bytes32=>mapping(bytes32=>bool)) private _attemptUsed;mapping(bytes32=>bool) private _scopeUsed;
    bytes32 public snapshotId;bool public initialized;uint256 public openCount;uint256 public pendingCount;uint256 public blockedCount;
    error Unauthorized();error InvalidScope();error Replay();event Initialized(bytes32 indexed snapshotId,uint256 count);event ScopeAdded(bytes32 indexed scopeId,T.ScopeKind kind);event AttemptChanged(bytes32 indexed scopeId,bytes32 indexed attemptId,T.AttemptStatus status);event LateDiscovery(bytes32 indexed scopeId,T.ScopeKind kind,bytes32 evidence);event ScopeResolved(bytes32 indexed scopeId,bytes32 evidence);
    constructor(address kernel_){if(kernel_==address(0))revert Unauthorized();kernel=kernel_;}
    function bindEmergencyModule(address module_) external {if(msg.sender!=IEmergencyRegistryAdmin(kernel).CONFIGURATION_ADMIN()||IEmergencyRegistryAdmin(kernel).lifecycle()!=T.Lifecycle.PAUSED||IEmergencyRegistryAdmin(kernel).modulesBound()||emergencyModule!=address(0)||module_.code.length==0)revert Unauthorized();if(IRegistryModule(module_).kernel()!=kernel||IRegistryModule(module_).moduleId()!=4||IRegistryModule(module_).moduleVersion()!=2)revert Unauthorized();emergencyModule=module_;emergencyModuleHash=_hash(module_);}
    function moduleId() external pure returns(uint8){return 5;}function moduleVersion() external pure returns(uint32){return 2;}
    function initialize(bytes32 snap,bytes32[] calldata ids,uint8[] calldata kinds) external {if(msg.sender!=emergencyModule||_hash(emergencyModule)!=emergencyModuleHash)revert Unauthorized();if(snap==0||ids.length==0||ids.length!=kinds.length||initialized||IEmergencyRegistryKernel(kernel).emergencySnapshotId()!=snap||IEmergencyRegistryKernel(kernel).lifecycle()!=T.Lifecycle.EMERGENCY_RECOVERY)revert InvalidScope();snapshotId=snap;initialized=true;for(uint256 i;i<ids.length;++i)_add(ids[i],kinds[i],bytes32(0));emit Initialized(snap,ids.length);}
    function beginAttempt(bytes32 snap,bytes32 id,bytes32 attemptId,uint32 number) external {if(msg.sender!=kernel)revert Unauthorized();_begin(snap,id,attemptId,number);}
    function beginWorkflowAttempt(bytes32 snap,bytes32 id,bytes32 attemptId,uint32 number) external {if(msg.sender!=emergencyModule||_hash(emergencyModule)!=emergencyModuleHash)revert Unauthorized();_begin(snap,id,attemptId,number);}
    function _begin(bytes32 snap,bytes32 id,bytes32 attemptId,uint32 number) private {if(!initialized||snap!=snapshotId||attemptId==0||number==0)revert InvalidScope();Scope storage s=_scopes[id];if(!_scopeUsed[id]||s.status==T.ScopeStatus.RESOLVED||number!=s.lastAttempt+1||_attemptUsed[id][attemptId])revert Replay();s.lastAttempt=number;_transition(s,T.ScopeStatus.PENDING);_attemptUsed[id][attemptId]=true;_attempts[id][attemptId]=T.Attempt(attemptId,number,uint64(block.timestamp),T.AttemptStatus.STARTED,0);emit AttemptChanged(id,attemptId,T.AttemptStatus.STARTED);}
    function finishAttempt(bytes32 snap,bytes32 id,bytes32 attemptId,uint32 number,T.AttemptStatus status,bytes32 evidence) external {if(msg.sender!=kernel)revert Unauthorized();_finish(snap,id,attemptId,number,status,evidence);}
    function finishWorkflowAttempt(bytes32 snap,bytes32 id,bytes32 attemptId,uint32 number,T.AttemptStatus status,bytes32 evidence) external {if(msg.sender!=emergencyModule||_hash(emergencyModule)!=emergencyModuleHash)revert Unauthorized();_finish(snap,id,attemptId,number,status,evidence);}
    function _finish(bytes32 snap,bytes32 id,bytes32 attemptId,uint32 number,T.AttemptStatus status,bytes32 evidence) private {if(!initialized||snap!=snapshotId||status==T.AttemptStatus.STARTED)revert InvalidScope();T.Attempt storage a=_attempts[id][attemptId];if(a.id!=attemptId||a.number!=number||a.status!=T.AttemptStatus.STARTED)revert Replay();a.status=status;a.evidence=evidence;Scope storage s=_scopes[id];s.evidence=evidence;T.ScopeStatus next=status==T.AttemptStatus.SUCCEEDED?T.ScopeStatus.RESOLVED:status==T.AttemptStatus.PENDING?T.ScopeStatus.PENDING:status==T.AttemptStatus.BLOCKED?T.ScopeStatus.BLOCKED:T.ScopeStatus.OPEN;_transition(s,next);emit AttemptChanged(id,attemptId,status);}
    function lateDiscovery(bytes32 snap,bytes32 id,uint8 kind,bytes32 evidence) external {if(msg.sender!=emergencyModule||_hash(emergencyModule)!=emergencyModuleHash||!initialized||snap!=snapshotId||evidence==0)revert Unauthorized();_add(id,kind,evidence);emit LateDiscovery(id,T.ScopeKind(kind),evidence);}
    function resolve(bytes32 snap,bytes32 id,bytes32 evidence) external {if(msg.sender!=emergencyModule||_hash(emergencyModule)!=emergencyModuleHash||!initialized||snap!=snapshotId||evidence==0||!_scopeUsed[id])revert Unauthorized();Scope storage s=_scopes[id];_transition(s,T.ScopeStatus.RESOLVED);s.evidence=evidence;emit ScopeResolved(id,evidence);}
    function summary(bytes32 snap) external view returns(uint256 scopes,uint256 open,uint256 pending,uint256 blocked,bool ready){if(snap!=snapshotId)return(0,0,0,0,false);return(_ids.length,openCount,pendingCount,blockedCount,initialized&&openCount==0&&pendingCount==0&&blockedCount==0);}
    function scope(bytes32 id) external view returns(Scope memory){return _scopes[id];}function scopeAt(uint256 i) external view returns(bytes32){return _ids[i];}function attempt(bytes32 id,bytes32 aid) external view returns(T.Attempt memory){return _attempts[id][aid];}
    function _add(bytes32 id,uint8 kind,bytes32 evidence) private {if(id==0||kind>uint8(T.ScopeKind.HOLDER_LIABILITY)||_scopeUsed[id])revert InvalidScope();_scopeUsed[id]=true;T.ScopeKind k=T.ScopeKind(kind);_scopes[id]=Scope(k,T.ScopeStatus.OPEN,evidence,0);_ids.push(id);openCount++;emit ScopeAdded(id,k);}
    function _transition(Scope storage s,T.ScopeStatus next) private {T.ScopeStatus old=s.status;if(old==next)return;if(old==T.ScopeStatus.OPEN)openCount--;else if(old==T.ScopeStatus.PENDING)pendingCount--;else if(old==T.ScopeStatus.BLOCKED)blockedCount--;if(next==T.ScopeStatus.OPEN)openCount++;else if(next==T.ScopeStatus.PENDING)pendingCount++;else if(next==T.ScopeStatus.BLOCKED)blockedCount++;s.status=next;}
    function _hash(address a) private view returns(bytes32 h){assembly{h:=extcodehash(a)}}
}
