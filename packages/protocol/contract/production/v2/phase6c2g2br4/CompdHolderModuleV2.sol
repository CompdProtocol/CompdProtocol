pragma solidity ^0.8.37;
import {C2G2BTypes as T,IC2G2BKernel,IC2G2BHolderDistributor,IC2G2BHolderLiability} from "./C2G2BTypes.sol";
interface IHolderKernelConfig {function distributor() external view returns(address);function distributorHash() external view returns(bytes32);function liability() external view returns(address);function liabilityHash() external view returns(bytes32);function failedHolder(bytes32) external view returns(bytes32,address,uint256,bytes32);function holderPaid(bytes32) external view returns(bool);}
interface IHolderFinality {function terminalReconciliation() external view returns(bytes32 digest,uint256 unresolved);}
interface IHolderCanonical {function canonicalPayment(bytes32) external view returns(bytes32,address,address,uint256,uint8,bool);}
contract CompdHolderModuleV2 {
    uint8 public constant MODULE_ID=1;uint32 public constant MODULE_VERSION=2;address public immutable kernel;address public immutable distributor;address public immutable liability;bytes32 public immutable distributorHash;bytes32 public immutable liabilityHash;
    struct PaymentHistory {bytes32 leafId;bytes32 useId;bytes32 digest;bytes32 attemptId;address recipient;uint256 amount;uint64 timestamp;bool retry;bool paid;}
    mapping(bytes32=>T.HolderPayment) private _failed;mapping(bytes32=>bool) public hasFailure;mapping(bytes32=>uint64) private _attemptCount;PaymentHistory[] private _history;bool private _entered;
    error Unauthorized();error InvalidPayment();error ChangedCode();event PaymentAttempt(bytes32 indexed useId,bytes32 indexed attemptId,bool retry,bool paid);
    modifier lock(){if(_entered)revert Unauthorized();_entered=true;_;_entered=false;}
    constructor(address k,address d,address l){if(k==address(0)||d.code.length==0||l.code.length==0||IHolderKernelConfig(k).distributor()!=d||IHolderKernelConfig(k).liability()!=l)revert Unauthorized();kernel=k;distributor=d;liability=l;distributorHash=_hash(d);liabilityHash=_hash(l);if(IHolderKernelConfig(k).distributorHash()!=distributorHash||IHolderKernelConfig(k).liabilityHash()!=liabilityHash)revert Unauthorized();}
    function moduleId() external pure returns(uint8){return MODULE_ID;}function moduleVersion() external pure returns(uint32){return MODULE_VERSION;}
    function pay(bytes32 leafId) external lock returns(bool){if(msg.sender!=_automation()||leafId==0)revert Unauthorized();_check();(T.HolderPayment memory p,bool proof)=IC2G2BHolderDistributor(distributor).paymentData(leafId);if(!proof||p.leafId!=leafId||p.useId==0||p.recipient==address(0)||p.asset!=address(0)||p.amount==0||p.distributionStatus!=1||p.liabilityStatus!=1||p.recoveryStatus!=0||(p.expiresAt!=0&&block.timestamp>p.expiresAt))revert InvalidPayment();bytes32 digest=_digest(p);_verifySources(p,digest);bytes32 attempt=_next(p.useId);bool paid=IC2G2BKernel(kernel).payHolder(leafId,p.useId,digest,p.recipient,p.amount,false,attempt);if(paid){delete _failed[p.useId];hasFailure[p.useId]=false;}else{_failed[p.useId]=p;hasFailure[p.useId]=true;}_history.push(PaymentHistory(leafId,p.useId,digest,attempt,p.recipient,p.amount,uint64(block.timestamp),false,paid));emit PaymentAttempt(p.useId,attempt,false,paid);return paid;}
    function retry(bytes32 useId) external lock returns(bool){if(msg.sender!=_automation()||!hasFailure[useId])revert Unauthorized();_check();T.HolderPayment memory p=_failed[useId];(bytes32 d,address recipient,uint256 amount,bytes32 leaf)=IHolderKernelConfig(kernel).failedHolder(useId);bytes32 digest=_digest(p);if(d!=digest||recipient!=p.recipient||amount!=p.amount||leaf!=p.leafId)revert InvalidPayment();_verifySources(p,digest);bytes32 attempt=_next(useId);bool paid=IC2G2BKernel(kernel).payHolder(p.leafId,useId,digest,p.recipient,p.amount,true,attempt);if(paid){delete _failed[useId];hasFailure[useId]=false;}_history.push(PaymentHistory(p.leafId,useId,digest,attempt,p.recipient,p.amount,uint64(block.timestamp),true,paid));emit PaymentAttempt(useId,attempt,true,paid);return paid;}
    function failed(bytes32 useId) external view returns(T.HolderPayment memory){return _failed[useId];}function historyLength() external view returns(uint256){return _history.length;}function historyAt(uint256 i) external view returns(PaymentHistory memory){return _history[i];}
    function terminationReady() external view returns(bool){for(uint256 i;i<_history.length;++i){bytes32 u=_history[i].useId;if(hasFailure[u]&&!IHolderKernelConfig(kernel).holderPaid(u))return false;}try IHolderFinality(distributor).terminalReconciliation() returns(bytes32 d1,uint256 n1){try IHolderFinality(liability).terminalReconciliation() returns(bytes32 d2,uint256 n2){return d1!=bytes32(0)&&d1==d2&&n1==0&&n2==0;}catch{return false;}}catch{return false;}}
    function _verifySources(T.HolderPayment memory p,bytes32 digest) private view {(bytes32 d1,address r1,address a1,uint256 n1,uint8 s1,bool valid1)=IHolderCanonical(distributor).canonicalPayment(p.leafId);(bytes32 d2,address r2,address a2,uint256 n2,uint8 s2,bool valid2)=IHolderCanonical(liability).canonicalPayment(p.leafId);if(!valid1||!valid2||d1!=digest||d2!=digest||r1!=p.recipient||r2!=p.recipient||a1!=address(0)||a2!=address(0)||n1!=p.amount||n2!=p.amount||s1!=1||s2!=1||IC2G2BHolderDistributor(distributor).paymentDigest(p.leafId)!=digest||IC2G2BHolderLiability(liability).paymentDigest(p.leafId)!=digest)revert InvalidPayment();}
    function _digest(T.HolderPayment memory p) private view returns(bytes32){return keccak256(abi.encode(keccak256("COMPD_HOLDER_PAYMENT_V2"),block.chainid,kernel,p.windowId,p.distributionId,p.version,p.index,p.root,p.lineage,p.leafId,p.recipient,p.asset,p.amount,p.distributionStatus,p.liabilityStatus,p.finalizedAt,p.expiresAt,p.recoveryStatus,p.useId));}
    function _next(bytes32 u) private returns(bytes32){uint64 n=++_attemptCount[u];return keccak256(abi.encode(address(this),block.chainid,u,n));}function _check() private view {if(_hash(distributor)!=distributorHash||_hash(liability)!=liabilityHash)revert ChangedCode();}function _automation() private pure returns(address){return 0xB878884A07Fc84e6A1336e15CA8C6580cD7164c3;}function _hash(address a) private view returns(bytes32 h){assembly{h:=extcodehash(a)}}
}
