pragma solidity ^0.8.37;

/// @notice Isolated bytecode/security-boundary study only. Never deploy.
interface IRehomeModule {function kernel() external view returns(address);function moduleId() external pure returns(uint8);function moduleVersion() external pure returns(uint32);}
interface IRehomeExecutor {
    function open(uint256 runId,uint256 amount,bytes32 evidence) external payable returns(bytes32);
    function closeToKernel(uint256 runId,bytes32 closeId) external returns(uint256 principal,uint256 returnedBNB,bytes32 evidence);
    function buyback(bytes32 operationId,bytes32 quoteId) external payable returns(uint256 spent,uint256 received,uint256 burned,bytes32 burnId);
}
interface IRehomeDistributor {function committedPayment(bytes32 leafId) external view returns(bytes32 digest,address recipient,uint256 amount,address asset,uint8 status);function markPaid(bytes32 leafId) external;}
interface IRehomeLiability {function paymentAuthorization(bytes32 leafId) external view returns(bytes32 digest,uint8 status);function markPaid(bytes32 leafId) external;}
interface IRehomeRecoveryEvidence {function protocolReserveEligible(bytes32 sourceId) external view returns(uint256 exactAmount);function holderLiabilityEligible(bytes32 sourceId) external view returns(uint256 exactAmount);function consumeProtocolReserve(bytes32 sourceId) external;function consumeHolderLiability(bytes32 sourceId) external;}

contract CompdVaultKernelV2RehomeProto {
    enum Life{ACTIVE,PAUSED,SHUTDOWN_PENDING,TERMINATED,EMERGENCY_RECOVERY}
    uint256 private constant MAX_BUYBACK=0.50 ether;uint256 private constant MIN_RESERVE=0.25 ether;uint64 private constant COOLDOWN=6 hours;uint64 private constant PERIOD=24 hours;
    address public constant ADMIN=0x7Ea65A566e08862ebaFabF564A7A069E10DFd5e9;address public constant GUARDIAN=0x34c5F07750aC19ff28d73FE039456Aa11e2f8eC1;address public constant TREASURY=0xFa8706AA97B07cb29096381f9101784bA0d1332b;
    address public immutable emergencyAuthority;address public immutable emergencyWallet;address public immutable executor;bytes32 public immutable executorHash;address public immutable buybackExecutor;bytes32 public immutable buybackExecutorHash;address public immutable distributor;bytes32 public immutable distributorHash;address public immutable liability;bytes32 public immutable liabilityHash;address public immutable recoveryEvidence;bytes32 public immutable recoveryEvidenceHash;
    address[6] public modules;bytes32[6] public moduleHashes;bool public bound;bool public funded;bool private entered;Life public lifecycle=Life.PAUSED;
    uint256 public strategyCapital;uint256 public buybackReserve;uint256 public protocolReserve;uint256 public holderRewardReserve;uint256 public accountedQuote;uint256 public activePrincipal;
    uint64 public lastBuyback;uint64 public periodStart;uint64 public shutdownAt;uint256 public periodStartReserve;uint256 public periodSpent;uint64 public emergencyNonce;bytes32 public emergencySnapshot;
    mapping(uint256=>uint256) public principalOf;mapping(uint256=>bool) public runUsed;mapping(bytes32=>bool) public allocationUsed;mapping(bytes32=>bool) public closeUsed;mapping(bytes32=>bool) public holderPaid;mapping(bytes32=>bool) public holderFailed;mapping(bytes32=>mapping(bytes32=>bool)) public holderAttemptUsed;mapping(bytes32=>bool) public recoveryUsed;mapping(bytes32=>bool) public emergencyTransferUsed;mapping(bytes32=>bool) public buybackUsed;
    error Unauthorized();error InvalidState();error InvalidAccounting();error InvalidAmount();error Replay();error BadEvidence();error RegistryNotRequired();
    modifier onlyModule(uint8 id){address m=modules[id];if(!bound||msg.sender!=m||_hash(m)!=moduleHashes[id])revert Unauthorized();_;}
    modifier lock(){if(entered)revert Unauthorized();entered=true;_;entered=false;}
    constructor(address authority,address wallet,address executor_,address buyback_,address distributor_,address liability_,address recoverySource){require(authority!=address(0)&&wallet!=address(0)&&executor_.code.length!=0&&buyback_.code.length!=0&&distributor_.code.length!=0&&liability_.code.length!=0&&recoverySource.code.length!=0);emergencyAuthority=authority;emergencyWallet=wallet;executor=executor_;executorHash=_hash(executor_);buybackExecutor=buyback_;buybackExecutorHash=_hash(buyback_);distributor=distributor_;distributorHash=_hash(distributor_);liability=liability_;liabilityHash=_hash(liability_);recoveryEvidence=recoverySource;recoveryEvidenceHash=_hash(recoverySource);}
    receive() external payable {if(msg.sender!=executor)revert Unauthorized();}
    function fund() external payable {if(msg.sender!=ADMIN||funded||lifecycle!=Life.PAUSED||msg.value==0)revert InvalidState();funded=true;strategyCapital+=msg.value;accountedQuote+=msg.value;_assert();}
    function bind(address[6] calldata m) external {if(msg.sender!=ADMIN||bound||lifecycle!=Life.PAUSED)revert InvalidState();for(uint8 i;i<6;++i){address a=m[i];if(a==address(0)||a.code.length==0||IRehomeModule(a).kernel()!=address(this)||IRehomeModule(a).moduleId()!=i||IRehomeModule(a).moduleVersion()!=2)revert Unauthorized();for(uint8 j;j<i;++j)if(m[j]==a)revert Unauthorized();modules[i]=a;moduleHashes[i]=_hash(a);}bound=true;}
    function activate() external {if(msg.sender!=ADMIN||!bound||!funded||lifecycle!=Life.PAUSED)revert InvalidState();_assert();lifecycle=Life.ACTIVE;}
    function pause() external {if(msg.sender!=GUARDIAN||lifecycle!=Life.ACTIVE)revert Unauthorized();lifecycle=Life.PAUSED;}
    function resume() external {if(msg.sender!=GUARDIAN||lifecycle!=Life.PAUSED)revert Unauthorized();_assert();lifecycle=Life.ACTIVE;}
    function beginShutdown(uint64 delay) external {if(msg.sender!=GUARDIAN||(lifecycle!=Life.ACTIVE&&lifecycle!=Life.PAUSED)||delay<72 hours)revert Unauthorized();shutdownAt=uint64(block.timestamp)+delay;lifecycle=Life.SHUTDOWN_PENDING;}
    function extendShutdown(uint64 newDeadline) external {if(msg.sender!=GUARDIAN||lifecycle!=Life.SHUTDOWN_PENDING||newDeadline<=shutdownAt)revert Unauthorized();shutdownAt=newDeadline;}
    function terminate() external {if(msg.sender!=GUARDIAN||lifecycle!=Life.SHUTDOWN_PENDING||block.timestamp<shutdownAt||activePrincipal!=0||holderRewardReserve!=0)revert Unauthorized();lifecycle=Life.TERMINATED;}
    function allocate(uint256 runId,uint256 amount,bytes32 allocationId) external onlyModule(0) lock {if(lifecycle!=Life.ACTIVE||runId==0||runUsed[runId]||allocationId==0||allocationUsed[allocationId]||amount==0||amount>strategyCapital-activePrincipal||amount>accountedQuote)revert InvalidAmount();_assert();runUsed[runId]=true;allocationUsed[allocationId]=true;principalOf[runId]=amount;activePrincipal+=amount;accountedQuote-=amount;_checkExecutor();if(IRehomeExecutor(executor).open{value:amount}(runId,amount,allocationId)!=allocationId)revert BadEvidence();_assert();}
    function settle(uint256 runId,bytes32 closeId) external onlyModule(0) lock {if(lifecycle!=Life.ACTIVE&&lifecycle!=Life.PAUSED&&lifecycle!=Life.SHUTDOWN_PENDING&&lifecycle!=Life.EMERGENCY_RECOVERY)revert InvalidState();uint256 p=principalOf[runId];if(p==0||closeId==0||closeUsed[closeId])revert Replay();_checkExecutor();uint256 before_=address(this).balance;(uint256 gotPrincipal,uint256 returned,bytes32 proof)=IRehomeExecutor(executor).closeToKernel(runId,closeId);if(gotPrincipal!=p||proof!=closeId||address(this).balance<before_||address(this).balance-before_!=returned)revert BadEvidence();closeUsed[closeId]=true;principalOf[runId]=0;activePrincipal-=p;accountedQuote+=returned;if(returned>=p){uint256 profit=returned-p;uint256 b=profit*15/100;uint256 h=profit*10/100;uint256 pr=profit*10/100;strategyCapital+=profit-b-h-pr;buybackReserve+=b;holderRewardReserve+=h;protocolReserve+=pr;}else strategyCapital-=p-returned;_assert();}
    /// @dev H-C: heavy proof/workflow validation stays outside; Kernel cross-checks the exact shared leaf digest and status from two fixed sources.
    function pay(bytes32 leafId) external onlyModule(1) lock returns(bool){return _pay(leafId,bytes32(0));}
    function retryPayment(bytes32 leafId,bytes32 retryId) external onlyModule(1) lock returns(bool){if(!holderFailed[leafId]||retryId==0||holderAttemptUsed[leafId][retryId])revert Replay();holderAttemptUsed[leafId][retryId]=true;return _pay(leafId,retryId);}
    function _pay(bytes32 leafId,bytes32 attemptId) private returns(bool){if(lifecycle!=Life.ACTIVE||holderPaid[leafId]||leafId==0)revert InvalidState();_checkHash(distributor,distributorHash);_checkHash(liability,liabilityHash);(bytes32 d,address to,uint256 amount,address asset,uint8 distStatus)=IRehomeDistributor(distributor).committedPayment(leafId);(bytes32 ld,uint8 liabilityStatus)=IRehomeLiability(liability).paymentAuthorization(leafId);bytes32 expected=keccak256(abi.encode(leafId,to,amount,asset,distStatus,liabilityStatus));if(d==0||d!=ld||d!=expected||distStatus!=1||liabilityStatus!=2||to==address(0)||asset!=address(0)||amount==0||amount>holderRewardReserve||amount>accountedQuote)revert BadEvidence();_assert();(bool ok,)=payable(to).call{value:amount,gas:50_000}("");if(!ok){bytes32 key=attemptId==0?keccak256(abi.encode(leafId,block.number,msg.sender)):attemptId;if(holderAttemptUsed[leafId][key])revert Replay();holderAttemptUsed[leafId][key]=true;holderFailed[leafId]=true;return false;}_checkHash(distributor,distributorHash);_checkHash(liability,liabilityHash);IRehomeDistributor(distributor).markPaid(leafId);IRehomeLiability(liability).markPaid(leafId);holderPaid[leafId]=true;holderFailed[leafId]=false;holderRewardReserve-=amount;accountedQuote-=amount;_assert();return true;}
    /// @dev Kernel keeps hard amount/velocity ceilings; quote path and 3% controls belong to the fixed executor/provider.
    function buyback(bytes32 id,uint256 amount,bytes32 quoteId) external onlyModule(2) lock {if(lifecycle!=Life.ACTIVE||id==0||buybackUsed[id]||buybackReserve<MIN_RESERVE||amount==0||amount>MAX_BUYBACK||amount>buybackReserve*20/100||amount>accountedQuote)revert InvalidAmount();if(lastBuyback!=0&&block.timestamp<uint256(lastBuyback)+COOLDOWN)revert InvalidState();if(periodStart==0||block.timestamp>=uint256(periodStart)+PERIOD){periodStart=uint64(block.timestamp);periodStartReserve=buybackReserve;periodSpent=0;}if(amount>periodStartReserve*20/100||periodSpent+amount>periodStartReserve*40/100)revert InvalidAmount();_assert();buybackUsed[id]=true;lastBuyback=uint64(block.timestamp);periodSpent+=amount;buybackReserve-=amount;accountedQuote-=amount;if(_hash(buybackExecutor)!=buybackExecutorHash)revert BadEvidence();(uint256 spent,uint256 received,uint256 burned,bytes32 burnId)=IRehomeExecutor(buybackExecutor).buyback{value:amount}(id,quoteId);if(spent!=amount||received==0||burned!=received||burnId==0)revert BadEvidence();_assert();}
    function recoverProtocolReserve(bytes32 sourceId,uint256 amount) external onlyModule(3) lock {if(lifecycle!=Life.TERMINATED||sourceId==0||amount==0||recoveryUsed[keccak256(abi.encode(uint8(0),sourceId))])revert InvalidState();_checkHash(recoveryEvidence,recoveryEvidenceHash);if(IRehomeRecoveryEvidence(recoveryEvidence).protocolReserveEligible(sourceId)!=amount||amount>protocolReserve||amount>accountedQuote)revert BadEvidence();recoveryUsed[keccak256(abi.encode(uint8(0),sourceId))]=true;_checkHash(recoveryEvidence,recoveryEvidenceHash);IRehomeRecoveryEvidence(recoveryEvidence).consumeProtocolReserve(sourceId);protocolReserve-=amount;accountedQuote-=amount;_send(TREASURY,amount);_assert();}
    function recoverHolderLiability(bytes32 sourceId,uint256 amount) external onlyModule(3) lock {if(lifecycle!=Life.TERMINATED||sourceId==0||amount==0||recoveryUsed[keccak256(abi.encode(uint8(1),sourceId))])revert InvalidState();_checkHash(recoveryEvidence,recoveryEvidenceHash);if(IRehomeRecoveryEvidence(recoveryEvidence).holderLiabilityEligible(sourceId)!=amount||amount>holderRewardReserve||amount>accountedQuote)revert BadEvidence();recoveryUsed[keccak256(abi.encode(uint8(1),sourceId))]=true;_checkHash(recoveryEvidence,recoveryEvidenceHash);IRehomeRecoveryEvidence(recoveryEvidence).consumeHolderLiability(sourceId);holderRewardReserve-=amount;accountedQuote-=amount;_send(TREASURY,amount);_assert();}
    /// @dev Deliberately Registry-independent. Emergency module handles subsequent scope workflow.
    function emergencyEnter() external lock {if(msg.sender!=emergencyAuthority||lifecycle==Life.TERMINATED||lifecycle==Life.EMERGENCY_RECOVERY)revert Unauthorized();_assert();if(activePrincipal>strategyCapital||accountedQuote<holderRewardReserve||address(this).balance<accountedQuote)revert InvalidAccounting();uint256 nonHolder=accountedQuote-holderRewardReserve;uint256 available=address(this).balance>nonHolder?address(this).balance-nonHolder:0;uint256 deficit=available>=holderRewardReserve?0:holderRewardReserve-available;unchecked{++emergencyNonce;}emergencySnapshot=keccak256(abi.encode(block.chainid,address(this),emergencyNonce,uint8(lifecycle),address(this).balance,accountedQuote,activePrincipal,holderRewardReserve,deficit));lifecycle=Life.EMERGENCY_RECOVERY;}
    function emergencyProtocolTransfer(uint256 amount,bytes32 sourceId) external onlyModule(4) lock {if(lifecycle!=Life.EMERGENCY_RECOVERY||amount==0||sourceId==0||emergencyTransferUsed[keccak256(abi.encode(uint8(0),sourceId))]||amount>protocolReserve||amount>accountedQuote)revert InvalidAmount();emergencyTransferUsed[keccak256(abi.encode(uint8(0),sourceId))]=true;protocolReserve-=amount;accountedQuote-=amount;_send(emergencyWallet,amount);_assert();}
    function emergencyBuybackTransfer(uint256 amount,bytes32 sourceId) external onlyModule(4) lock {if(lifecycle!=Life.EMERGENCY_RECOVERY||amount==0||sourceId==0||emergencyTransferUsed[keccak256(abi.encode(uint8(1),sourceId))]||amount>buybackReserve||amount>accountedQuote)revert InvalidAmount();emergencyTransferUsed[keccak256(abi.encode(uint8(1),sourceId))]=true;buybackReserve-=amount;accountedQuote-=amount;_send(emergencyWallet,amount);_assert();}
    function _send(address to,uint256 amount) private {uint256 b=address(this).balance;(bool ok,)=payable(to).call{value:amount,gas:50_000}("");if(!ok||b<address(this).balance||b-address(this).balance!=amount)revert InvalidAmount();}
    function _assert() private view {if(strategyCapital+buybackReserve+protocolReserve+holderRewardReserve!=accountedQuote+activePrincipal||activePrincipal>strategyCapital||accountedQuote<holderRewardReserve||address(this).balance<accountedQuote)revert InvalidAccounting();}
    function _checkExecutor() private view {if(_hash(executor)!=executorHash)revert BadEvidence();}
    function _checkHash(address source,bytes32 expected) private view {if(_hash(source)!=expected)revert BadEvidence();}
    function _hash(address a) private view returns(bytes32 h){assembly{h:=extcodehash(a)}}
}

abstract contract RehomeModuleBase {address public immutable kernel;uint8 public immutable moduleId;uint32 public constant moduleVersion=2;constructor(address k,uint8 id){kernel=k;moduleId=id;}modifier onlyKernel(){require(msg.sender==kernel);_;}}
contract RehomeSettlementModule is RehomeModuleBase {constructor(address k)RehomeModuleBase(k,0){}function allocate(uint256 id,uint256 amount,bytes32 evidence)external{CompdVaultKernelV2RehomeProto(payable(kernel)).allocate(id,amount,evidence);}function settle(uint256 id,bytes32 evidence)external{CompdVaultKernelV2RehomeProto(payable(kernel)).settle(id,evidence);}}
contract RehomeHolderModule is RehomeModuleBase {constructor(address k)RehomeModuleBase(k,1){}function pay(bytes32 leaf)external returns(bool){return CompdVaultKernelV2RehomeProto(payable(kernel)).pay(leaf);}function retryPayment(bytes32 leaf,bytes32 attempt)external returns(bool){return CompdVaultKernelV2RehomeProto(payable(kernel)).retryPayment(leaf,attempt);}}
contract RehomeBuybackModule is RehomeModuleBase {constructor(address k)RehomeModuleBase(k,2){}function buyback(bytes32 id,uint256 amount,bytes32 quote)external{CompdVaultKernelV2RehomeProto(payable(kernel)).buyback(id,amount,quote);}}
contract RehomeRecoveryModule is RehomeModuleBase {constructor(address k)RehomeModuleBase(k,3){}function protocolReserve(bytes32 id,uint256 amount)external{CompdVaultKernelV2RehomeProto(payable(kernel)).recoverProtocolReserve(id,amount);}function holderLiability(bytes32 id,uint256 amount)external{CompdVaultKernelV2RehomeProto(payable(kernel)).recoverHolderLiability(id,amount);}}
contract RehomeEmergencyModule is RehomeModuleBase {constructor(address k)RehomeModuleBase(k,4){}function protocolTransfer(uint256 amount,bytes32 source)external{CompdVaultKernelV2RehomeProto(payable(kernel)).emergencyProtocolTransfer(amount,source);}function buybackTransfer(uint256 amount,bytes32 source)external{CompdVaultKernelV2RehomeProto(payable(kernel)).emergencyBuybackTransfer(amount,source);}}
contract RehomeRegistryModule is RehomeModuleBase {constructor(address k)RehomeModuleBase(k,5){} }
